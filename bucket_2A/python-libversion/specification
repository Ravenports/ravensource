DEF[PORTVERSION]=	1.2.4
# ------------------------------------------------------------------------

NAMEBASE=		python-libversion
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Python bindings for libversion (3.14)
SDESC[v15]=		Python bindings for libversion (3.15)
HOMEPAGE=		https://github.com/repology/py-libversion
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/l/libversion
DISTFILE[1]=		libversion-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		libversion-${PORTVERSION}

# install_requires extracted from setup.py


[PY314].USES_ON=			python:v14,sutools
[PY315].USES_ON=			python:v15,sutools

USES=			pkgconfig
BUILDRUN_DEPENDS=	libversion:single:std

LICENSE=		MIT:single
LICENSE_FILE=		MIT:{{WRKSRC}}/LICENSE
LICENSE_SCHEME=		solo
