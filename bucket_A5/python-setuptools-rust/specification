DEF[PORTVERSION]=	1.13.0
# ------------------------------------------------------------------------

NAMEBASE=		python-setuptools-rust
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Setuptools Rust extension plugin (3.14)
SDESC[v15]=		Setuptools Rust extension plugin (3.15)
HOMEPAGE=		https://github.com/PyO3/setuptools-rust
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/0b/80/909e46e684e47b116ed145bf2a1a8f5f7c9d90e8c3f8f7fce6a529c0068d
DISTFILE[1]=		setuptools_rust-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		setuptools_rust-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# setuptools>=62.4
# semantic_version<3,>=2.8.2

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-setuptools:single:v14
					python-semantic-version:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-setuptools:single:v15
					python-semantic-version:single:v15

