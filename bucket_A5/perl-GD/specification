NAMEBASE=		perl-GD
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Interface to the libgd graphics library (5.42)
SDESC[544]=		Interface to the libgd graphics library (5.44)
HOMEPAGE=		https://github.com/lstein/Perl-GD
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:R/RU/RURBAN
DISTFILE[1]=		GD-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		GD-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Math::Trig (perl 5.42 core) (perl 5.44 core)
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::Constant (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::PkgConfig
# |    configure : File::Which
# |         test : Test::Fork
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)
# |         test : Test::NoWarnings

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILD_DEPENDS_ON=		perl-ExtUtils-PkgConfig:single:542
					perl-File-Which:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILD_DEPENDS_ON=		perl-ExtUtils-PkgConfig:single:544
					perl-File-Which:single:544

USES=			pkgconfig
BUILD_DEPENDS=		libGD:dev:std
BUILDRUN_DEPENDS=	libGD:primary:std
