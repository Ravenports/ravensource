# Move to snapshot like FreeBSD to get Qt6 support
DEF[PORTVERSION]=	3.13.99
# 5 commits behind current "continuous", 6 NOV 2026
DEF[TAG]=		efe03c0
# ----------------------------------------------------------------------------

NAMEBASE=		sqlitebrowser
VERSION=		${PORTVERSION}
KEYWORDS=		databases
VARIANTS=		std
SDESC[std]=		Visual tool to manage SQLite databases
HOMEPAGE=		https://sqlitebrowser.org/
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
SITES[main]=		GITHUB/sqlitebrowser:sqlitebrowser:${TAG}
DISTFILE[1]=		generated:main

SPKGS[std]=		single

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		MPL:single GPLv3+:single
LICENSE_FILE=		MPL:stock
			GPLv3+:stock
LICENSE_TERMS=		single:{{WRKDIR}}/TERMS
LICENSE_AWK=		TERMS:"^----"
LICENSE_SOURCE=		TERMS:{{WRKSRC}}/LICENSE
LICENSE_SCHEME=		dual

FPC_EQUIVALENT=		databases/sqlitebrowser

BUILD_DEPENDS=		qt6-qttools:set:std
			qt6-qt5compat:dev:std
			qscintilla:dev:qt6
BUILDRUN_DEPENDS=	qt6-qt5compat:primary:std
			qscintilla:primary:qt6

USES=			cmake sqlite qt6
			desktop-utils:single
			gnome-icons:single
MAKE_ENV=		LANG=en_US.UTF-8
CMAKE_ARGS=		-DCMAKE_PREFIX_PATH:PATH="{{PREFIX}}/lib/qt6/cmake/"
			-DQSCINTILLA_INCLUDE_DIR={{LOCALBASE}}/include/qt6/Qsci
			-DQSCINTILLA_LIBRARY={{LOCALBASE}}/lib/qt6/libqscintilla2_qt6.so
			-DQT_MAJOR=Qt6
			-Wno-author

post-patch:
	${REINPLACE_CMD} -e 's|%%DATADIR%%|${PREFIX}/share/${NAMEBASE}|' \
		${WRKSRC}/src/PreferencesDialog.cpp \
		${WRKSRC}/src/Application.cpp

post-install:
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/sqlitebrowser
