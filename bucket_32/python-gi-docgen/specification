DEF[PORTVERSION]=	2026.1
# ------------------------------------------------------------------------

NAMEBASE=		python-gi-docgen
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Documentation tool for GObject-based libs (3.14)
SDESC[v15]=		Documentation tool for GObject-based libs (3.15)
HOMEPAGE=		https://gitlab.gnome.org/GNOME/gi-docgen
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/b2/fe/b15e5cdbced9b3ff9790362b207102bbedb53f99bbf7cc8bfd4a6aa04b79
DISTFILE[1]=		gi_docgen-${PORTVERSION}-py2.py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		set primary dev
SPKGS[v15]=		set primary dev

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# GPL-3.0-or-later AND Apache-2.0 AND CC0-1.0

GENERATED=		yes
DISTNAME=		gi_docgen-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# Markdown>=3.2
# MarkupSafe
# Pygments
# jinja2
# packaging
# tomli; python_version < "3.11"
# typogrify

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-Markdown:single:v14
					python-MarkupSafe:single:v14
					python-Pygments:single:v14
					python-Jinja2:single:v14
					python-packaging:single:v14
					python-typogrify:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-Markdown:single:v15
					python-MarkupSafe:single:v15
					python-Pygments:single:v15
					python-Jinja2:single:v15
					python-packaging:single:v15
					python-typogrify:single:v15

pre-install:
	${MV} ${STAGEDIR}${PREFIX}/share/pkgconfig/gi-docgen.pc ${STAGEDIR}${PREFIX}/lib/pkgconfig/gi-docgen.pc
	${RMDIR} ${STAGEDIR}${PREFIX}/share/pkgconfig
# Add path with our prefix to the hard-coded xdg_data_dirs
	${REINPLACE_CMD} 's!/usr/share:!/${PREFIX}/share:/usr/share:!' ${STAGEDIR}${PREFIX}/lib/python${PYTHON_VER}/site-packages/gidocgen/utils.py
