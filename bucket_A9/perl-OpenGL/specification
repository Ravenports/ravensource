DEF[PORTVERSION]=	0.7009
# ------------------------------------------------------------------------

NAMEBASE=		perl-OpenGL
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Bindings to OpenGL API, GLU, GLUT/FreeGLUT (5.42)
SDESC[544]=		Bindings to OpenGL API, GLU, GLUT/FreeGLUT (5.44)
HOMEPAGE=		https://github.com/Perl-GPU/pogl
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:E/ET/ETJ
DISTFILE[1]=		OpenGL-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# unknown

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		OpenGL-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : OpenGL::Modern
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-OpenGL-Modern:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-OpenGL-Modern:single:544

BUILD_DEPENDS=		freeglut:dev:std
BUILDRUN_DEPENDS=	freeglut:primary:std

CONFIGURE_ARGS=		interface=FREEGLUT verbose
XORG_COMPONENTS=	x11 xext xmu xi ice

pre-configure:
	${REINPLACE_CMD} -e 's|/usr/local|${LOCALBASE}|g' ${WRKSRC}/Makefile.PL
	${REINPLACE_CMD} -e 's|LDFLAGS=|LDFLAGS=-L${LOCALBASE}/lib -Wl,-rpath,${LOCALBASE}/lib |' \
		${WRKSRC}/utils/Makefile
	${REINPLACE_CMD} -e 's|glBindBufferARB|glBindBuffer|g' \
		${WRKSRC}/lib/OpenGL/V1.xs

post-install:
	${RM} ${STAGEDIR}${SITE_ARCH}/OpenGL/GLUT.pm
	${RM} ${STAGEDIR}${SITE_ARCH}/auto/OpenGL/GLUT/GLUT.so
	${RM} ${STAGEDIR}${SITE_MAN3}/OpenGL::GLUT.3
	${RMDIR} ${STAGEDIR}${SITE_ARCH}/auto/OpenGL/GLUT
