DEF[PORTVERSION]=	2.88
# ------------------------------------------------------------------------

NAMEBASE=		perl-Razor2-Client-Agent
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		UI routines for razor agents (5.42)
SDESC[544]=		UI routines for razor agents (5.44)
HOMEPAGE=		https://github.com/cpan-authors/Razor2-Client-Agent
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:T/TO/TODDR
DISTFILE[1]=		Razor2-Client-Agent-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Razor2-Client-Agent-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Digest::SHA (perl 5.42 core) (perl 5.44 core)
# |      runtime : File::Copy (perl 5.42 core) (perl 5.44 core)
# |      runtime : File::Spec (perl 5.42 core) (perl 5.44 core)
# |      runtime : File::Temp (perl 5.42 core) (perl 5.44 core)
# |      runtime : Getopt::Long (perl 5.42 core) (perl 5.44 core)
# |      runtime : IO::Socket::IP (perl 5.42 core) (perl 5.44 core)
# |      runtime : MIME::Base64 (perl 5.42 core) (perl 5.44 core)
# |      runtime : Time::HiRes (perl 5.42 core) (perl 5.44 core)
# |      runtime : URI::Escape
# |      runtime : parent (perl 5.42 core) (perl 5.44 core)
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : File::Temp (perl 5.42 core) (perl 5.44 core)
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-URI:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-URI:single:544

post-install:
	# relocate stray man pages
	${MKDIR} ${STAGEDIR}${PREFIX}/${SITE_PERL_REL}/man/man5
	${MV} ${STAGEDIR}${MANPREFIX}/man/man5/razor* \
		${STAGEDIR}${PREFIX}/${SITE_PERL_REL}/man/man5/
