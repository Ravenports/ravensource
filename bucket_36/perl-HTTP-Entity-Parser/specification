NAMEBASE=		perl-HTTP-Entity-Parser
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		PSGI compliant HTTP Entity Parser (5.42)
SDESC[544]=		PSGI compliant HTTP Entity Parser (5.44)
HOMEPAGE=		https://github.com/kazeburo/HTTP-Entity-Parser
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:K/KA/KAZEBURO
DISTFILE[1]=		HTTP-Entity-Parser-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		HTTP-Entity-Parser-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Encode (perl 5.42 core) (perl 5.44 core)
# |      runtime : File::Temp (perl 5.42 core) (perl 5.44 core)
# |      runtime : HTTP::MultiPartParser
# |      runtime : Hash::MultiValue
# |      runtime : JSON::MaybeXS
# |      runtime : Module::Load (perl 5.42 core) (perl 5.44 core)
# |      runtime : Stream::Buffered
# |      runtime : WWW::Form::UrlEncoded
# |    configure : Module::Build::Tiny
# |         test : Cwd (perl 5.42 core) (perl 5.44 core)
# |         test : File::Spec::Functions (perl 5.42 core) (perl 5.44 core)
# |         test : HTTP::Message
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,buildmodtiny,run
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-HTTP-MultiPartParser:single:542
					perl-Hash-MultiValue:single:542
					perl-JSON-MaybeXS:single:542
					perl-Stream-Buffered:single:542
					perl-WWW-Form-UrlEncoded:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-Module-Build-Tiny:single:542
[PERL_544].USES_ON=			perl:544,buildmodtiny,run
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-HTTP-MultiPartParser:single:544
					perl-Hash-MultiValue:single:544
					perl-JSON-MaybeXS:single:544
					perl-Stream-Buffered:single:544
					perl-WWW-Form-UrlEncoded:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-Module-Build-Tiny:single:544

