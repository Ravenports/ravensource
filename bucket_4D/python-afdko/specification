# Manually maintained (due to weird defcon, fonttools notation) and antlr/libxml deps
DEF[PORTVERSION]=	5.0.1
DEF[ANTLR4_TAG]=	df4d68c
# ------------------------------------------------------------------------

NAMEBASE=		python-afdko
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v15 v14
SDESC[v15]=		Adobe Font Development Kit for OpenType (3.15)
SDESC[v14]=		Adobe Font Development Kit for OpenType (3.14)
HOMEPAGE=		https://pypi.org/project/afdko/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main antlr4
SITES[main]=		PYPI/a/afdko
SITES[antlr4]=		GITHUB/antlr:antlr4:${ANTLR4_TAG}
DISTFILE[1]=		afdko-${PORTVERSION}.tar.gz:main
DISTFILE[2]=		generated:antlr4
DIST_SUBDIR=		python-src
DF_INDEX=		1 2

SPKGS[v15]=		single
SPKGS[v14]=		single

OPTIONS_AVAILABLE=	PY315 PY314
OPTIONS_STANDARD=	none
VOPTS[v15]=		PY315=ON PY314=OFF
VOPTS[v14]=		PY315=OFF PY314=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		afdko-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: scikit-build-core
# build: setuptools-scm
# build: cython
# buildrun: typing_extensions >= 4.0; python_version < '3.11'
# buildrun: lxml >= 6.0.0
# buildrun: booleanOperations >= 0.9.0
# buildrun: defcon[lxml,pens] >= 0.10.3
# buildrun: fontMath >= 0.9.4
# buildrun: fontTools[unicode,woff,lxml,ufo] >= 4.59.0
# buildrun: tqdm >= 4.66.1
# buildrun: ufonormalizer >= 0.6.2
# buildrun: ufoProcessor >= 1.13.1

[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-scikit-build-core:single:v15
					python-setuptools-scm:single:v15
					python-Cython:single:v15
[PY315].BUILDRUN_DEPENDS_ON=		python-lxml:single:v15
					python-booleanOperations:single:v15
					python-defcon:single:v15
					python-fontMath:single:v15
					python-fonttools:single:v15
					python-tqdm:single:v15
					python-ufonormalizer:single:v15
					python-ufoProcessor:single:v15
[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-scikit-build-core:single:v14
					python-setuptools-scm:single:v14
					python-Cython:single:v14
[PY314].BUILDRUN_DEPENDS_ON=		python-lxml:single:v14
					python-booleanOperations:single:v14
					python-defcon:single:v14
					python-fontMath:single:v14
					python-fonttools:single:v14
					python-tqdm:single:v14
					python-ufonormalizer:single:v14
					python-ufoProcessor:single:v14
[PY315].MAKEFILE_ON=			ANTREP="{{WRKDIR}}/antlr4-${ANTLR4_TAG}"
[PY314].MAKEFILE_ON=			ANTREP="{{WRKDIR}}/antlr4-${ANTLR4_TAG}"

GNOME_COMPONENTS=	libxml2
