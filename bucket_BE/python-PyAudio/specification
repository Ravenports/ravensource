DEF[PORTVERSION]=	0.2.14
# ------------------------------------------------------------------------

NAMEBASE=		python-PyAudio
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Bindings for PortAudio v19 (3.14)
SDESC[v15]=		Bindings for PortAudio v19 (3.15)
HOMEPAGE=		https://people.csail.mit.edu/hubert/pyaudio/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/P/PyAudio
DISTFILE[1]=		PyAudio-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
