DEF[PORTVERSION]=	22.1.8
DEF[IXML]=		22.1.8
DEF[UPNP]=		22.1.8
# ----------------------------------------------------------------------------

NAMEBASE=		libupnp
VERSION=		${PORTVERSION}
KEYWORDS=		devel
VARIANTS=		std
SDESC[std]=		Portable SDK for UPnP Devices
HOMEPAGE=		https://github.com/pupnp/pupnp/
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		https://github.com/pupnp/pupnp/releases/download/release-${PORTVERSION}/
DISTFILE[1]=		libupnp-${PORTVERSION}.tar.bz2:main

SPKGS[std]=		set primary dev tools

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		BSD3CLAUSE:primary
LICENSE_FILE=		BSD3CLAUSE:{{WRKSRC}}/COPYING
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		devel/upnp

USES=			cpe ssl cmake pkgconfig
CPE_VENDOR=		libupnp_project
CMAKE_ARGS=		-DUPNP_ENABLE_BLOCKING_TCP_CONNECTIONS:BOOL=ON
			-DUPNP_ENABLE_OPEN_SSL:BOOL=ON
# #-DOPENSSL_ROOT_DIR:STRING="{{OPENSSLLIB}}"

PLIST_SUB=		IXML=${IXML}
			IXMLMAJ=${IXML:R:R}
			UPNP=${UPNP}
			UPNPMAJ=${UPNP:R:R}
