DEF[PORTVERSION]=	1.1.2
# ------------------------------------------------------------------------

NAMEBASE=		python-scikit-build-core
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Build backend for CMake based projects (3.14)
SDESC[v15]=		Build backend for CMake based projects (3.15)
HOMEPAGE=		https://github.com/scikit-build/scikit-build-core
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/cb/8e/f13e5d7dc75fc979464d5bcc1bc762b07133df3d09d667c34727dfd8b0e8
DISTFILE[1]=		scikit_build_core-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		scikit_build_core-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# exceptiongroup>=1.0; python_version < '3.11'
# packaging>=23.2
# pathspec>=0.12.0
# tomli>=1.2.2; python_version < '3.11'
# typing-extensions>=4; python_version < '3.11'
# hatchling>=1.24; extra == 'hatchling'
# setuptools>=45; (python_version == '3.9') and extra == 'setuptools'
# setuptools>=49; (python_version >= '3.10' and python_version < '3.12') and extra == 'setuptools'
# setuptools>=66.1; (python_version >= '3.12') and extra == 'setuptools'
# setuptools>=70.1; extra == 'wheel-free-setuptools'
# cmake!=4.4.0; (sys_platform == 'win32') and extra == 'wheels'
# cmake; (sys_platform != 'win32') and extra == 'wheels'
# ninja; (sys_platform != 'win32') and extra == 'wheels'

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-packaging:single:v14
					python-pathspec:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-packaging:single:v15
					python-pathspec:single:v15

RUN_DEPENDS=		cmake:primary:std
