# Requires-Dist extracted from wheel metadata
# exceptiongroup>=1.0; python_version < '3.11'
# packaging>=23.2
# pathspec>=0.12.0
# tomli>=1.2.2; python_version < '3.11'
# typing-extensions>=4; python_version < '3.11'
# hatchling>=1.24; extra == 'hatchling'
# setuptools>=45; (python_version == '3.9') and extra == 'setuptools'
# setuptools>=49; (python_version >= '3.10' and python_version < '3.12') and extra == 'setuptools'
# setuptools>=66.1; (python_version >= '3.12') and extra == 'setuptools'
# setuptools>=70.1; extra == 'wheel-free-setuptools'
# cmake!=4.4.0; (sys_platform == 'win32') and extra == 'wheels'
# cmake; (sys_platform != 'win32') and extra == 'wheels'
# ninja; (sys_platform != 'win32') and extra == 'wheels'

[PY313].USES_ON=			python:v13,wheel
[PY313].RUN_DEPENDS_ON=			python-packaging:single:v13
					python-pathspec:single:v13
[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-packaging:single:v14
					python-pathspec:single:v14

