Work around multibyte bug on NetBSD (standards/60369)

--- meson.build.orig	2026-02-06 07:30:55 UTC
+++ meson.build
@@ -629,6 +629,7 @@ complete_run = custom_target(
   'complete-run',
   input: ['testcases/complete-run.pl.in'],
   output: ['complete-run.pl'],
+  env: {'LC_ALL': 'C'},
   command: replace_dirs,
   # build this target when running e.g. ninja or ninja test.
   # This is required for older meson versions (< 0.46.0).
@@ -638,6 +639,7 @@ i3test_pm = custom_target(
   'i3test-pm',
   input: ['testcases/lib/i3test.pm.in'],
   output: ['i3test.pm'],
+  env: {'LC_ALL': 'C'},
   command: replace_dirs,
   # build this target when running e.g. ninja or ninja test.
   # This is required for older meson versions (< 0.46.0).
