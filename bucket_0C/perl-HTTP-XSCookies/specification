DEF[PORTVERSION]=	0.000021
# ------------------------------------------------------------------------

NAMEBASE=		perl-HTTP-XSCookies
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Fast XS cookie mangling for Perl (5.42)
SDESC[544]=		Fast XS cookie mangling for Perl (5.44)
HOMEPAGE=		https://github.com/gonzus/http-xscookies
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:G/GO/GONZUS
DISTFILE[1]=		HTTP-XSCookies-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# mit

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		HTTP-XSCookies-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : XSLoader (perl 5.42 core) (perl 5.44 core)
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : Data::Dumper (perl 5.42 core) (perl 5.44 core)
# |         test : Date::Parse
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_544].USES_ON=			perl:544,configure

VAR_OPSYS[linux]=	CFLAGS=-Doff64_t=__off64_t

post-patch-sunos:
	${REINPLACE_CMD} -e '/XOPEN_SOURCE/d' ${WRKSRC}/Makefile.PL
