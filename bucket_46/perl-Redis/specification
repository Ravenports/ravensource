NAMEBASE=		perl-Redis
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Perl binding for Redis database (5.42)
SDESC[544]=		Perl binding for Redis database (5.44)
HOMEPAGE=		https://github.com/PerlRedis/perl-redis
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:D/DA/DAMS
DISTFILE[1]=		Redis-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# artistic_2

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Redis-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : IO::Socket::Timeout
# |      runtime : Try::Tiny
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : Module::Build::Tiny
# |         test : Digest::SHA (perl 5.42 core) (perl 5.44 core)
# |         test : File::Spec (perl 5.42 core) (perl 5.44 core)
# |         test : IO::Handle (perl 5.42 core) (perl 5.44 core)
# |         test : IO::String
# |         test : IPC::Cmd (perl 5.42 core) (perl 5.44 core)
# |         test : IPC::Open3 (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Deep
# |         test : Test::Fatal
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)
# |         test : Test::SharedFork
# |         test : Test::TCP

[PERL_542].USES_ON=			perl:542,buildmodtiny,run
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-IO-Socket-Timeout:single:542
					perl-Try-Tiny:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-Module-Build-Tiny:single:542
[PERL_544].USES_ON=			perl:544,buildmodtiny,run
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-IO-Socket-Timeout:single:544
					perl-Try-Tiny:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-Module-Build-Tiny:single:544

