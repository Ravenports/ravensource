DEF[PORTVERSION]=	27.3.0
# ------------------------------------------------------------------------

NAMEBASE=		python-pyzmq
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Python bindings for 0MQ (3.14)
SDESC[v15]=		Python bindings for 0MQ (3.15)
HOMEPAGE=		https://pyzmq.readthedocs.org
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/pyzmq
DISTFILE[1]=		pyzmq-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		pyzmq-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: cython>=3.0.0; implementation_name != 'pypy'
# build: packaging
# build: scikit-build-core>=0.10

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-Cython:single:v14
					python-packaging:single:v14
					python-scikit-build-core:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-Cython:single:v15
					python-packaging:single:v15
					python-scikit-build-core:single:v15

LICENSE=		BSD3CLAUSE:single
LICENSE_FILE=		BSD3CLAUSE:{{WRKSRC}}/LICENSE.md
LICENSE_SCHEME=		solo

BUILD_DEPENDS=		zeromq:dev:std
BUILDRUN_DEPENDS=	zeromq:primary:std
MAKE_ENV=		CMAKE_GENERATOR="Unix Makefiles"
