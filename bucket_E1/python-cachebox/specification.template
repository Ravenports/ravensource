DEF[PORTVERSION]=	%%VERSION%%
# ------------------------------------------------------------------------

NAMEBASE=		python-cachebox
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v15 v14
SDESC[v15]=		Memoizing and caching library (3.15)
SDESC[v14]=		Memoizing and caching library (3.14)
HOMEPAGE=		https://github.com/awolverp/cachebox
CONTACT=		Python_Automaton[python@ravenports.com]

%%DOWNLOAD_GROUPS%%
SITES[main]=		PYPI/c/cachebox
%%CR_SITES%%

DISTFILE[1]=		cachebox-${PORTVERSION}.tar.gz:main
%%CR_DISTFILES%%
%%DF_INDEX%%

SPKGS[v15]=		single
SPKGS[v14]=		single

OPTIONS_AVAILABLE=	PY315 PY314
OPTIONS_STANDARD=	none
VOPTS[v15]=		PY315=ON PY314=OFF
VOPTS[v14]=		PY315=OFF PY314=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		cachebox-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: maturin>=1.8,<2.0

[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-maturin:single:v15
[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-maturin:single:v14

USES=			cargo cclibs:single
CARGO_SKIP_CONFIGURE=	yes
CARGO_SKIP_BUILD=	yes
CARGO_SKIP_INSTALL=	yes
