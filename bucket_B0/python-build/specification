DEF[PORTVERSION]=	1.6.0
# ------------------------------------------------------------------------

NAMEBASE=		python-build
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v13 v14
SDESC[v13]=		Simple, correct Python build frontend (3.13)
SDESC[v14]=		Simple, correct Python build frontend (3.14)
HOMEPAGE=		https://build.pypa.io
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/ab/e5/aa1e81b21aea0ce0ba435311837a37d4cb936e7461f9fecac08580073ba9
DISTFILE[1]=		build-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v13]=		single
SPKGS[v14]=		single

OPTIONS_AVAILABLE=	PY313 PY314
OPTIONS_STANDARD=	none
VOPTS[v13]=		PY313=ON PY314=OFF
VOPTS[v14]=		PY313=OFF PY314=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		build-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# packaging >= 24.0
# pyproject_hooks
# colorama; os_name == "nt"
# importlib-metadata >= 4.6; python_full_version < "3.10.2"
# tomli >= 1.1.0; python_version < "3.11"
# keyring ; extra == "keyring"
# uv >= 0.1.18 ; extra == "uv"
# virtualenv >= 20.36.1 ; extra == "virtualenv"

[PY313].USES_ON=			python:v13,wheel
[PY313].RUN_DEPENDS_ON=			python-packaging:single:v13
					python-pyproject-hooks:single:v13
					python-colorama:single:v13
					python-importlib-metadata:single:v13
[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-packaging:single:v14
					python-pyproject-hooks:single:v14
					python-colorama:single:v14
					python-importlib-metadata:single:v14

