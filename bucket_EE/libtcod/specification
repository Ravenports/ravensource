DEF[PORTVERSION]=	2.3.2
DEF[SOVERSION]=		2.3.2
DEF[JQUERY]=		EXTRACT_INFO(LATEST_JQUERY)
DEF[UNDERSCORE]=	EXTRACT_INFO(SPHINX_UNDERSCORE)
DEF[STB_HASH]=		4e9b368
DEF[PNG_HASH]=		7b2893e
# ----------------------------------------------------------------------------

NAMEBASE=		libtcod
VERSION=		${PORTVERSION}
KEYWORDS=		devel
VARIANTS=		std
SDESC[std]=		Roguelike game development library
HOMEPAGE=		https://github.com/libtcod/libtcod
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main stb lodepng
SITES[main]=		GITHUB/libtcod:libtcod:${PORTVERSION}
SITES[stb]=		GITHUB/nothings:stb:${STB_HASH}
SITES[lodepng]=		GITHUB/lvandeve:lodepng:${PNG_HASH}
DISTFILE[1]=		generated:main
DISTFILE[2]=		generated:stb
DISTFILE[3]=		generated:lodepng
DF_INDEX=		1 2 3

# Drop samples, they don't build on linux (drop docs too, see below)
SPKGS[std]=		set primary dev

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		BSD3CLAUSE:primary
LICENSE_FILE=		BSD3CLAUSE:{{WRKSRC}}/LICENSE.txt
LICENSE_SCHEME=		solo

BUILD_DEPENDS=		utf8proc:dev:std
BUILDRUN_DEPENDS=	utf8proc:primary:std

USES=			cmake pkgconfig zlib c++:primary
# XORG_COMPONENTS=	x11
SDL_COMPONENTS=		sdl3

CMAKE_ARGS=		-DLIBTCOD_SAMPLES:BOOL=OFF
			-DLIBTCOD_SDL3:BOOL=ON
			-DLIBTCOD_ZLIB:BOOL=ON
			-DBUILD_SHARED_LIBS:BOOL=ON
			-DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON
			-DFETCHCONTENT_SOURCE_DIR_STB={{WRKDIR}}/stb-${STB_HASH}
			-DFETCHCONTENT_SOURCE_DIR_LODEPNG-C={{WRKDIR}}/lodepng-${PNG_HASH}
PLIST_SUB=		JQUERY=${JQUERY}
			UNDERSCORE=${UNDERSCORE}
SOVERSION=		${SOVERSION}


post-patch:
	(cd ${WRKDIR}/stb-${STB_HASH} && ${PATCH} -p1 < ${WRKSRC}/cmake/stb.patch)
	(cd ${WRKDIR}/lodepng-${PNG_HASH} && ${PATCH} -p1 < ${WRKSRC}/cmake/lodepng-c.patch)

post-install:
	${MKDIR} ${STAGEDIR}${PREFIX}/share/libtcod
	(cd ${WRKSRC} && ${COPYTREE_SHARE} data ${STAGEDIR}${PREFIX}/share/libtcod/)
	${INSTALL_DATA} ${WRKSRC}/terminal.png ${STAGEDIR}${PREFIX}/share/libtcod/
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/libtcod.so
