DEF[PORTVERSION]=	2.0.4
# ------------------------------------------------------------------------

NAMEBASE=		python-pycups
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Python bindings for libcups (3.14)
SDESC[v15]=		Python bindings for libcups (3.15)
HOMEPAGE=		https://github.com/OpenPrinting/pycups
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/pycups
DISTFILE[1]=		pycups-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# GPLv2+

GENERATED=		yes
DISTNAME=		pycups-${PORTVERSION}

# install_requires extracted from setup.py


[PY314].USES_ON=			python:v14,sutools
[PY315].USES_ON=			python:v15,sutools

BUILD_DEPENDS=		cups:dev:std
			cups:primary:std
RUN_DEPENDS=		cups:tools:std
USES=			iconv
