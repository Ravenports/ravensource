DEF[PORTVERSION]=	0.003
# ------------------------------------------------------------------------

NAMEBASE=		perl-CPAN-Requirements-Dynamic
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Dynamic prerequisites in meta files (5.42)
SDESC[544]=		Dynamic prerequisites in meta files (5.44)
HOMEPAGE=		https://github.com/Leont/cpan-requirements-dynamic
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:L/LE/LEONT
DISTFILE[1]=		CPAN-Requirements-Dynamic-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		CPAN-Requirements-Dynamic-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : CPAN::Meta::Prereqs (perl 5.42 core) (perl 5.44 core)
# |      runtime : CPAN::Meta::Requirements::Range (perl 5.42 core) (perl 5.44 core)
# |      runtime : Carp (perl 5.42 core) (perl 5.44 core)
# |      runtime : ExtUtils::Config
# |      runtime : ExtUtils::HasCompiler
# |      runtime : IPC::Cmd (perl 5.42 core) (perl 5.44 core)
# |      runtime : Parse::CPAN::Meta (perl 5.42 core) (perl 5.44 core)
# |      runtime : Perl::OSType (perl 5.42 core) (perl 5.44 core)
# |      runtime : strict (perl 5.42 core) (perl 5.44 core)
# |      runtime : warnings (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-ExtUtils-Config:single:542
					perl-ExtUtils-HasCompiler:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-ExtUtils-Config:single:544
					perl-ExtUtils-HasCompiler:single:544

