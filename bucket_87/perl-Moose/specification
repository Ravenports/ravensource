DEF[PORTVERSION]=	2.4000
# ------------------------------------------------------------------------

NAMEBASE=		perl-Moose
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Postmodern object system for Perl 5 (5.42)
SDESC[544]=		Postmodern object system for Perl 5 (5.44)
HOMEPAGE=		https://github.com/moose/Moose
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:E/ET/ETHER
DISTFILE[1]=		Moose-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Moose-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Carp (perl 5.42 core) (perl 5.44 core)
# |      runtime : Class::Load
# |      runtime : Class::Load::XS
# |      runtime : Data::OptList
# |      runtime : Devel::GlobalDestruction
# |      runtime : Devel::OverloadInfo
# |      runtime : Devel::StackTrace
# |      runtime : Dist::CheckConflicts
# |      runtime : Eval::Closure
# |      runtime : List::Util (perl 5.42 core) (perl 5.44 core)
# |      runtime : MRO::Compat
# |      runtime : Module::Runtime
# |      runtime : Module::Runtime::Conflicts
# |      runtime : Package::DeprecationManager
# |      runtime : Package::Stash
# |      runtime : Package::Stash::XS
# |      runtime : Params::Util
# |      runtime : Scalar::Util (perl 5.42 core) (perl 5.44 core)
# |      runtime : Sub::Exporter
# |      runtime : Sub::Util (perl 5.42 core) (perl 5.44 core)
# |      runtime : Try::Tiny
# |      runtime : parent (perl 5.42 core) (perl 5.44 core)
# |      runtime : strict (perl 5.42 core) (perl 5.44 core)
# |      runtime : warnings (perl 5.42 core) (perl 5.44 core)
# |      runtime : Data::OptList
# |    configure : Dist::CheckConflicts
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : CPAN::Meta::Check
# |         test : CPAN::Meta::Requirements (perl 5.42 core) (perl 5.44 core)
# |         test : File::Spec (perl 5.42 core) (perl 5.44 core)
# |         test : Module::Metadata (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Fatal
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Needs
# |         test : CPAN::Meta (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Class-Load:single:542
					perl-Class-Load-XS:single:542
					perl-Data-OptList:single:542
					perl-Devel-GlobalDestruction:single:542
					perl-Devel-OverloadInfo:single:542
					perl-Devel-StackTrace:single:542
					perl-Dist-CheckConflicts:single:542
					perl-Eval-Closure:single:542
					perl-MRO-Compat:single:542
					perl-Module-Runtime:single:542
					perl-Module-Runtime-Conflicts:single:542
					perl-Package-DeprecationManager:single:542
					perl-Package-Stash:single:542
					perl-Package-Stash-XS:single:542
					perl-Params-Util:single:542
					perl-Sub-Exporter:single:542
					perl-Try-Tiny:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Class-Load:single:544
					perl-Class-Load-XS:single:544
					perl-Data-OptList:single:544
					perl-Devel-GlobalDestruction:single:544
					perl-Devel-OverloadInfo:single:544
					perl-Devel-StackTrace:single:544
					perl-Dist-CheckConflicts:single:544
					perl-Eval-Closure:single:544
					perl-MRO-Compat:single:544
					perl-Module-Runtime:single:544
					perl-Module-Runtime-Conflicts:single:544
					perl-Package-DeprecationManager:single:544
					perl-Package-Stash:single:544
