DEF[PORTVERSION]=	3.1.0
# ------------------------------------------------------------------------

NAMEBASE=		python-sphinx-rtd-theme
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Read the Docs theme for Sphinx (3.14)
SDESC[v15]=		Read the Docs theme for Sphinx (3.15)
HOMEPAGE=		https://github.com/readthedocs/sphinx_rtd_theme
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/87/c7/b5c8015d823bfda1a346adb2c634a2101d50bb75d421eb6dcb31acd25ebc
DISTFILE[1]=		sphinx_rtd_theme-${PORTVERSION}-py2.py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		sphinx_rtd_theme-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# sphinx<10,>=6
# docutils<0.23,>0.18
# sphinxcontrib-jquery<5,>=4
# transifex-client; extra == "dev"
# bump2version; extra == "dev"
# wheel; extra == "dev"
# twine; extra == "dev"

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-Sphinx:single:v14
					python-docutils:single:v14
					python-sphinxcontrib-jquery:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-Sphinx:single:v15
					python-docutils:single:v15
					python-sphinxcontrib-jquery:single:v15

# avoid use of node and node-sass
MAKE_ENV=		CI=yes
CONFIGURE_ENV=		CI=yes
