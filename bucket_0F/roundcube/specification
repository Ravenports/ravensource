DEF[PORTVERSION]=	1.7.7
# ----------------------------------------------------------------------------

NAMEBASE=		roundcube
VERSION=		${PORTVERSION}
KEYWORDS=		mail www
VARIANTS=		php84 php85 php86
SDESC[php84]=		Open source webmail software (php84)
SDESC[php85]=		Open source webmail software (php85)
SDESC[php86]=		Open source webmail software (php86)
HOMEPAGE=		https://roundcube.net/
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
SITES[main]=		https://github.com/roundcube/roundcubemail/releases/download/${PORTVERSION}/
DISTFILE[1]=		roundcubemail-${PORTVERSION}-complete.tar.gz:main

SPKGS[php84]=		set primary docs
SPKGS[php85]=		set primary docs
SPKGS[php86]=		set primary docs

OPTIONS_AVAILABLE=	P84 P85 P86
OPTIONS_STANDARD=	none
VOPTS[php84]=		P86=OFF P84=ON P85=OFF
VOPTS[php85]=		P86=OFF P84=OFF P85=ON
VOPTS[php86]=		P86=ON P84=OFF P85=OFF

FPC_EQUIVALENT=		mail/roundcube

LICENSE=		GPLv3+:primary
LICENSE_FILE=		GPLv3+:{{WRKSRC}}/docs/LICENSE.md
LICENSE_TERMS=		primary:{{WRKDIR}}/TERMS
LICENSE_SCHEME=		solo

SUB_FILES=		newsyslog.conf
SUB_LIST=		WWWDIR="{{PREFIX}}/www/roundcube"

USES=			cpe
CPE_VENDOR=		roundcube
CPE_PRODUCT=		webmail
DISTNAME=		roundcubemail-${PORTVERSION}
SKIP_BUILD=		yes

[P84].DESCRIPTION=			Build upon PHP 8.4
[P84].RUN_DEPENDS_ON=			php84-mbstring:single:std
					php84-session:single:std
					php84-iconv:single:std
					php84-dom:single:std
					php84-xml:single:std
					php84-intl:single:std
					php84-zip:single:std
					php84-filter:single:std
					php84-openssl:single:std
					php84-fileinfo:single:std
					php84-exif:single:std
					php84-ctype:single:std
					php84-gd:single:std
					php84-enchant:single:std
					php84-pdo_sqlite:single:std
					php84-pdo_pgsql:single:std
					php84-pdo_mysql:single:std

[P85].DESCRIPTION=			Build upon PHP 8.5
[P85].RUN_DEPENDS_ON=			php85-mbstring:single:std
					php85-session:single:std
					php85-iconv:single:std
					php85-dom:single:std
					php85-xml:single:std
					php85-intl:single:std
					php85-zip:single:std
					php85-filter:single:std
					php85-openssl:single:std
					php85-fileinfo:single:std
					php85-exif:single:std
					php85-ctype:single:std
					php85-gd:single:std
					php85-enchant:single:std
					php85-pdo_sqlite:single:std
					php85-pdo_pgsql:single:std
					php85-pdo_mysql:single:std

[P86].DESCRIPTION=			Build upon PHP 8.6
[P86].RUN_DEPENDS_ON=			php86-mbstring:single:std
					php86-session:single:std
					php86-iconv:single:std
					php86-dom:single:std
					php86-xml:single:std
					php86-intl:single:std
					php86-zip:single:std
					php86-filter:single:std
					php86-openssl:single:std
					php86-fileinfo:single:std
					php86-exif:single:std
					php86-ctype:single:std
					php86-gd:single:std
					php86-enchant:single:std
					php86-pdo_sqlite:single:std
					php86-pdo_pgsql:single:std
					php86-pdo_mysql:single:std

post-extract:
	${AWK} '/^LICENSE/,/^CONTRIBUTION/' ${WRKSRC}/README.md > ${WRKDIR}/TERMS

pre-configure:
	${FIND} ${WRKSRC} -type f -name "*.orig" -delete

do-install:
	${MKDIR} ${STAGEDIR}${PREFIX}/www/roundcube
	${MKDIR} ${STAGEDIR}${STD_DOCDIR}
	${MKDIR} ${STAGEDIR}${PREFIX}/etc/newsyslog.conf.d
	cd ${WRKSRC} && \
		${COPYTREE_BIN} bin ${STAGEDIR}${PREFIX}/www/roundcube
.for i in SQL config index.php installer logs plugins program skins temp vendor
	cd ${WRKSRC} && \
		${COPYTREE_SHARE} ${i} ${STAGEDIR}${PREFIX}/www/roundcube
.endfor
.for i in CHANGELOG.md README.md
	${INSTALL_DATA} ${WRKSRC}/${i} ${STAGEDIR}${STD_DOCDIR}/
.endfor
	${INSTALL_DATA} ${WRKDIR}/newsyslog.conf \
		${STAGEDIR}${PREFIX}/etc/newsyslog.conf.d/roundcube.conf.sample
