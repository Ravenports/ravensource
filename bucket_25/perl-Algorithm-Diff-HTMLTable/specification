NAMEBASE=		perl-Algorithm-Diff-HTMLTable
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Show differences of a file as a HTML table (5.42)
SDESC[544]=		Show differences of a file as a HTML table (5.44)
HOMEPAGE=		https://github.com/reneeb/Algorithm-Diff-HTMLTable
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:R/RE/RENEEB
DISTFILE[1]=		Algorithm-Diff-HTMLTable-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# artistic_2

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Algorithm-Diff-HTMLTable-${PORTVERSION}

