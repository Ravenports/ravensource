# |      runtime : Carp (perl 5.42 core) (perl 5.44 core)
# |      runtime : HTML::Entities
# |      runtime : Test::LongString
# |      runtime : Time::Piece (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Algorithm-Diff:single:542
					perl-HTML-Parser:single:542
					perl-Test-LongString:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Algorithm-Diff:single:544
					perl-HTML-Parser:single:544
					perl-Test-LongString:single:544

