DEF[PORTVERSION]=	4.0.3
# ------------------------------------------------------------------------

NAMEBASE=		ruby-rbs
VERSION=		${PORTVERSION}
KEYWORDS=		ruby
VARIANTS=		v33 v34 v40
SDESC[v33]=		Type signature for Ruby (v33)
SDESC[v34]=		Type signature for Ruby (v34)
SDESC[v40]=		Type signature for Ruby (v40)
HOMEPAGE=		https://github.com/ruby/rbs
CONTACT=		Ruby_Automaton[ruby@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		RUBYGEMS/
DISTFILE[1]=		rbs-4.0.3.gem:main
DIST_SUBDIR=		ruby

SPKGS[v33]=		single
SPKGS[v34]=		single
SPKGS[v40]=		single

OPTIONS_AVAILABLE=	RUBY33 RUBY34 RUBY40
OPTIONS_STANDARD=	none
VOPTS[v33]=		RUBY33=ON RUBY34=OFF RUBY40=OFF
VOPTS[v34]=		RUBY33=OFF RUBY34=ON RUBY40=OFF
VOPTS[v40]=		RUBY33=OFF RUBY34=OFF RUBY40=ON

# License listed inside gem specification
# => UNSET

# Requirements according to gem specification:
#   logger (>= 0)
#   prism (>= 1.6.0)
#   tsort (>= 0)

DISTNAME=		rbs-${PORTVERSION}
GENERATED=		yes

[RUBY33].USES_ON=			gem:v33
[RUBY33].BUILDRUN_DEPENDS_ON=		ruby-logger:single:v33
					ruby-prism:single:v33
					ruby-tsort:single:v33
[RUBY34].USES_ON=			gem:v34
[RUBY34].BUILDRUN_DEPENDS_ON=		ruby-logger:single:v34
					ruby-prism:single:v34
					ruby-tsort:single:v34
[RUBY40].USES_ON=			gem:v40
[RUBY40].BUILDRUN_DEPENDS_ON=		ruby-logger:single:v40
					ruby-prism:single:v40
					ruby-tsort:single:v40

