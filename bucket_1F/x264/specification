DEF[X264_BUILD]=	165
DEF[X264_REV]=		3223
DEF[X264_COMMIT]=	00852f599572d10798b2dafd2c5286213d0ce795
DEF[X264_GITVER]=	00852f5
DEF[PORTVERSION]=	0.${X264_BUILD}.${X264_REV}
# NOTES
# We use tarballs from the *stable* branch of the upstream git repository.
# X264_BUILD is the "core" number, and can be found in x264.h.
# >> https://code.videolan.org/videolan/x264/commits/stable
# X264_REV requires a checkout the git revision for the version the port
# is being updated to. Then run version.sh against it.
# ----------------------------------------------------------------------------

NAMEBASE=		x264
VERSION=		${PORTVERSION}
KEYWORDS=		multimedia
VARIANTS=		std
SDESC[std]=		H.264/MPEG-4 AVC Video Encoder
HOMEPAGE=		https://www.videolan.org/developers/x264.html
CONTACT=		nobody

# Requires human interaction.  Locally host it.
# https://gitlab.freedesktop.org/gstreamer/meson-ports/x264/-/archive/<hash>/x264-<hash>.tar.gz
# old location: https://code.videolan.org/videolan/x264/-/archive/${X264_GITVER}/

DOWNLOAD_GROUPS=	main
SITES[main]=		RAVEN/
DISTFILE[1]=		x264-${X264_COMMIT}.tar.gz:main
DIST_SUBDIR=		x264

SPKGS[std]=		set primary dev tools

OPTIONS_AVAILABLE=	ASM
OPTIONS_STANDARD=	ASM
OPT_ON[x86_64]=		ASM
OPT_ON[i386]=		ASM

LICENSE=		GPLv2+:primary
LICENSE_FILE=		GPLv2+:{{WRKSRC}}/COPYING
LICENSE_TERMS=		primary:{{WRKDIR}}/TERMS
LICENSE_AWK=		TERMS:"^$$"
LICENSE_SOURCE=		TERMS:{{WRKSRC}}/x264.h
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		multimedia/x264

BUILD_DEPENDS=		l-smash:dev:std
BUILDRUN_DEPENDS=	l-smash:primary:std
			bash-completion:single:std

USES=			meson pkgconfig shebangfix
SHEBANG_GLOB=		*.py
PLIST_SUB=		X264_BUILD=${X264_BUILD}
DISTNAME=		x264-${X264_COMMIT}

# lavf requires ffmpeg causing circular dependency failure
MESON_ARGS=		-Dlavf=disabled
			-Dgpac=disabled
			-Dffms=disabled
			-Dswscale=disabled
			-Dlsmash=enabled


[ASM].BUILD_DEPENDS_ON=			nasm:primary:std
[ASM].CONFIGURE_ARGS_OFF=		-Dasm=disabled
					-Dvsx=disabled

pre-configure:
	${REINPLACE_CMD} -e 's|%%DISTVERSION%%|${PORTVERSION}|g' \
	    ${PATCH_WRKSRC}/meson.build
	${REINPLACE_CMD} -e 's|%%GIT_COMMIT_HASH%%|${X264_COMMIT}|g' \
	    ${PATCH_WRKSRC}/meson.build

post-install:
	${MKDIR} ${STAGEDIR}${PREFIX}/share/bash-completion/completions
	${INSTALL_SCRIPT} ${WRKSRC}/tools/bash-autocomplete.sh \
		${STAGEDIR}${PREFIX}/share/bash-completion/completions/x264
