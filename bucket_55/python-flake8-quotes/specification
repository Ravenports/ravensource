DEF[PORTVERSION]=	3.4.0
# ------------------------------------------------------------------------

NAMEBASE=		python-flake8-quotes
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Flake8 lint for quotes (3.14)
SDESC[v15]=		Flake8 lint for quotes (3.15)
HOMEPAGE=		https://github.com/zheller/flake8-quotes/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/f/flake8-quotes
DISTFILE[1]=		flake8-quotes-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		flake8-quotes-${PORTVERSION}

# install_requires extracted from setup.py
# flake8
# setuptools

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-flake8:single:v14
					python-setuptools:single:v14
[PY315].USES_ON=			python:v15,sutools
[PY315].BUILDRUN_DEPENDS_ON=		python-flake8:single:v15
					python-setuptools:single:v15

