DEF[PORTVERSION]=	3.19.33
DEF[SOVERSION]=		3.19.33
DEF[TAG]=		${PORTVERSION}
# ----------------------------------------------------------------------------

NAMEBASE=		freeimage
VERSION=		${PORTVERSION}
KEYWORDS=		graphics
VARIANTS=		std
SDESC[std]=		Simple C/C++ bitmap graphics library
HOMEPAGE=		https://freeimage.sourceforge.io/
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		GITHUB/danoli3:FreeImage:${TAG}
DISTFILE[1]=		generated:main

SPKGS[std]=		set primary dev

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		CUSTOM1:primary
LICENSE_FILE=		CUSTOM1:{{WRKSRC}}/license-fi.txt
LICENSE_NAME=		CUSTOM1:"FreeImage Public License - Version 1.0"
LICENSE_TERMS=		primary:{{WRKDIR}}/TERMS
LICENSE_SOURCE=		TERMS:{{WRKSRC}}/Source/FreeImage.h
LICENSE_AWK=		TERMS:"FREEIMAGE_H"
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		graphics/freeimage

BUILD_DEPENDS=		openjpeg:dev:std
			jpeg-turbo:dev:std
			openexr:dev:std
			libraw:dev:std
			WebP:dev:std
BUILDRUN_DEPENDS=	openjpeg:primary:std
			jpeg-turbo:primary:std
			openexr:primary:std
			libraw:primary:std
			WebP:primary:std

USES=			c++:primary dos2unix cmake cpe
			zlib png tiff jpeg pkgconfig
CPE_VENDOR=		freeimage_project
CPE_PRODUCT=		freeimage
CMAKE_ARGS=		-DBUILD_SHARED_LIBS:BOOL=ON
			-DUSE_LIBJPEG_TURBO:BOOL=ON
			-DFREEIMAGE_USE_SYSTEM_LIBS:BOOL=ON
SUB_FILES=		freeimage.pc
SUB_LIST=		VERSION="${PORTVERSION}"
SOVERSION=		${SOVERSION}

post-install:
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/libFreeImage.so
