DEF[PORTVERSION]=	3.05
# ------------------------------------------------------------------------

NAMEBASE=		perl-Starlink-AST
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Interface to the Starlink AST library (5.42)
SDESC[544]=		Interface to the Starlink AST library (5.44)
HOMEPAGE=		https://github.com/Starlink/perl-Starlink-AST.git
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:G/GS/GSB
DISTFILE[1]=		Starlink-AST-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# gpl_2

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Starlink-AST-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Astro::FITS::CFITSIO
# |      runtime : Astro::FITS::Header
# |      runtime : Tk
# |      runtime : Tk::Zinc
# |        build : ExtUtils::CBuilder (perl 5.42 core) (perl 5.44 core)
# |        build : Test::Deep
# |        build : Test::More (perl 5.42 core) (perl 5.44 core)
# |        build : Test::Number::Delta
# |    configure : Module::Build

[PERL_542].USES_ON=			perl:542,buildmod,run
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Astro-FITS-CFITSIO:single:542
					perl-Astro-FITS-Header:single:542
					perl-Tk:single:542
					perl-Tk-Zinc:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-Test-Deep:single:542
					perl-Test-Number-Delta:single:542
					perl-Module-Build:single:542
[PERL_544].USES_ON=			perl:544,buildmod,run
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Astro-FITS-CFITSIO:single:544
					perl-Astro-FITS-Header:single:544
					perl-Tk:single:544
					perl-Tk-Zinc:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-Test-Deep:single:544
					perl-Test-Number-Delta:single:544
					perl-Module-Build:single:544

