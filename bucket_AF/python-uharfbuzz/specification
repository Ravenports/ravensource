DEF[PORTVERSION]=	0.57.0
# ------------------------------------------------------------------------

NAMEBASE=		python-uharfbuzz
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Steamlined harfbuzz cpython bindings (3.14)
SDESC[v15]=		Steamlined harfbuzz cpython bindings (3.15)
HOMEPAGE=		https://github.com/trufont/uharfbuzz
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/u/uharfbuzz
DISTFILE[1]=		uharfbuzz-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Apache License 2.0

GENERATED=		yes
DISTNAME=		uharfbuzz-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: setuptools_scm >= 2.1
# build: cython >= 3.1
# build: pkgconfig

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-setuptools-scm:single:v14
					python-Cython:single:v14
					python-pkgconfig:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-setuptools-scm:single:v15
					python-Cython:single:v15
					python-pkgconfig:single:v15

BUILD_DEPENDS=		harfbuzz:dev:std
BUILDRUN_DEPENDS=	harfbuzz:primary:std

MAKE_ENV=		CYTHON_ANNOTATE=0
			CYTHON_LINETRACE=0
			USE_SYSTEM_LIBS=1
