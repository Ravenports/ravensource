DEF[PORTVERSION]=	2.010001
# ------------------------------------------------------------------------

NAMEBASE=		perl-Type-Tiny
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Moo(se) compatible type constraint (5.42)
SDESC[544]=		Moo(se) compatible type constraint (5.44)
HOMEPAGE=		https://github.com/tobyink/p5-type-tiny
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:T/TO/TOBYINK
DISTFILE[1]=		Type-Tiny-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Type-Tiny-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Exporter::Tiny
# |      runtime : Class::XSAccessor
# |      runtime : Devel::LexAlias
# |      runtime : Devel::StackTrace
# |      runtime : Ref::Util::XS
# |      runtime : Regexp::Util
# |      runtime : Sub::Util (perl 5.42 core) (perl 5.44 core)
# |      runtime : Type::Tiny::XS
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : CPAN::Meta::Requirements (perl 5.42 core) (perl 5.44 core)
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Deep
# |         test : Test::Tester (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Warnings

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Exporter-Tiny:single:542
					perl-Class-XSAccessor:single:542
					perl-Devel-LexAlias:single:542
					perl-Devel-StackTrace:single:542
					perl-Ref-Util-XS:single:542
					perl-Regexp-Util:single:542
					perl-Type-Tiny-XS:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Exporter-Tiny:single:544
					perl-Class-XSAccessor:single:544
					perl-Devel-LexAlias:single:544
					perl-Devel-StackTrace:single:544
					perl-Ref-Util-XS:single:544
					perl-Regexp-Util:single:544
					perl-Type-Tiny-XS:single:544

# On solaris "file" locks up on /construction/perl-Type-Tiny/stage/
# raven/lib/perl5/site_perl/Type/Tiny/Manual/Params.pod
#
# as a workaround, don't autostrip this port
SET_DEBUGGING_ON=	yes
