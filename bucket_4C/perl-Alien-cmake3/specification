DEF[PORTVERSION]=	0.10
# ------------------------------------------------------------------------

NAMEBASE=		perl-Alien-cmake3
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Find or download or build cmake 3 (5.42)
SDESC[544]=		Find or download or build cmake 3 (5.44)
HOMEPAGE=		https://github.com/PerlAlien/Alien-cmake3
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:P/PL/PLICEASE
DISTFILE[1]=		Alien-cmake3-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Alien-cmake3-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Alien::Base
# |        build : Alien::Build
# |        build : Alien::Build::MM
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : Alien::Build
# |    configure : Alien::Build::MM
# |    configure : Capture::Tiny
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : File::Which
# |    configure : Path::Tiny
# |         test : Test2::V0 (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Alien

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Alien-Build:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-Capture-Tiny:single:542
					perl-File-Which:single:542
					perl-Path-Tiny:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Alien-Build:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-Capture-Tiny:single:544
					perl-File-Which:single:544
					perl-Path-Tiny:single:544

# Same issue as Alien::CFITSIO
BUILDRUN_DEPENDS=	cmake:primary:std
