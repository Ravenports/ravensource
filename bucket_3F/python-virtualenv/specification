DEF[PORTVERSION]=	21.15.0
# ------------------------------------------------------------------------

NAMEBASE=		python-virtualenv
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v13 v14
SDESC[v13]=		Virtual Python Environment builder (3.13)
SDESC[v14]=		Virtual Python Environment builder (3.14)
HOMEPAGE=		https://github.com/pypa/virtualenv
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/0f/25/fe570da03bdfda1bd489f3286ff9ca820e15ad8a1480d0d2c12871d58c84
DISTFILE[1]=		virtualenv-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v13]=		single
SPKGS[v14]=		single

OPTIONS_AVAILABLE=	PY313 PY314
OPTIONS_STANDARD=	none
VOPTS[v13]=		PY313=ON PY314=OFF
VOPTS[v14]=		PY313=OFF PY314=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		virtualenv-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# distlib<1,>=0.4.3
# filelock<5,>=3.24.2; python_version >= '3.10'
# filelock<=3.19.1,>=3.19.1; python_version < '3.10'
# packaging>=26.3
# platformdirs<5,>=4.4
# python-discovery>=1.6.1
# typing-extensions>=4.16; python_version < '3.11'

[PY313].USES_ON=			python:v13,wheel
[PY313].RUN_DEPENDS_ON=			python-distlib:single:v13
					python-filelock:single:v13
					python-packaging:single:v13
					python-platformdirs:single:v13
					python-python-discovery:single:v13
[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-distlib:single:v14
					python-filelock:single:v14
					python-packaging:single:v14
					python-platformdirs:single:v14
					python-python-discovery:single:v14

USES=			cpe
CPE_VENDOR=		python
CPE_PRODUCT=		virtualenv
