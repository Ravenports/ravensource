DEF[PORTVERSION]=	2.36
# ------------------------------------------------------------------------

NAMEBASE=		perl-PGPLOT
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		PGPLOT wrapper for perl (5.42)
SDESC[544]=		PGPLOT wrapper for perl (5.44)
HOMEPAGE=		https://github.com/PDLPorters/perl5-PGPLOT
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:E/ET/ETJ
DISTFILE[1]=		PGPLOT-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# unknown

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		PGPLOT-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : PDL
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : Devel::CheckLib
# |    configure : ExtUtils::F77
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-PDL:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-Devel-CheckLib:single:542
					perl-ExtUtils-F77:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-PDL:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-Devel-CheckLib:single:544
					perl-ExtUtils-F77:single:544

BUILD_DEPENDS=		perl-File-Which:single:perl_used
BUILDRUN_DEPENDS=	pgplot:primary:std
XORG_COMPONENTS=	x11
C_USES[freebsd]=	fortran:single
C_USES[linux]=		fortran:single

post-patch:
	${REINPLACE_CMD} -e 's|/usr/local|${PREFIX}|g' ${WRKSRC}/Makefile.PL
	${RM} -r ${WRKSRC}/lib/PDL

post-install:
	${STRIP_CMD} ${STAGEDIR}${SITE_PERL}/mach/${PERL_VER}/auto/PGPLOT/PGPLOT.so
