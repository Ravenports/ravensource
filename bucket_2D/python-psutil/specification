# manually updated
DEF[PORTVERSION]=	7.2.2
# ------------------------------------------------------------------------

NAMEBASE=		python-psutil
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v15 v14
SDESC[v15]=		Process utilities module (3.15)
SDESC[v14]=		Process utilities module (3.14)
HOMEPAGE=		https://github.com/giampaolo/psutil
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/psutil
DISTFILE[1]=		psutil-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v15]=		single
SPKGS[v14]=		single

OPTIONS_AVAILABLE=	PY315 PY314
OPTIONS_STANDARD=	none
VOPTS[v15]=		PY315=ON PY314=OFF
VOPTS[v14]=		PY315=OFF PY314=ON

DISTNAME=		psutil-${PORTVERSION}
FPC_EQUIVALENT=		sysutils/py-psutil

ONLY_FOR_OPSYS=		freebsd netbsd linux sunos

[PY315].USES_ON=			python:v15,sutools
[PY314].USES_ON=			python:v14,sutools

post-install:
	${STRIP_CMD} ${STAGEDIR}${PYTHON_SITELIBDIR}/psutil/*.so
