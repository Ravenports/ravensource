VARIANTS=		v14 v15
SDESC[v14]=		TCP port monitoring and discovery (3.14)
SDESC[v15]=		TCP port monitoring and discovery (3.15)
HOMEPAGE=		https://github.com/jaraco/portend
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/49/11/b0b19077f80cb8972b44c96af983e8cfcdb1506090bacef137ed8b448af8
DISTFILE[1]=		portend-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
