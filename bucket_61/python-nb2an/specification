NAMEBASE=		python-nb2an
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Netbox to Ansible config comparison tool (3.14)
SDESC[v15]=		Netbox to Ansible config comparison tool (3.15)
HOMEPAGE=		https://github.com/hardaker/nb2an
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
