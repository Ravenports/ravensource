# using fedora versions (prepatched)
DEF[PORTVERSION]=	5.45.4
DEF[PATCH_VERSION]=	1
DEF[TAG]=		v${PATCH_VERSION}
# ----------------------------------------------------------------------------

NAMEBASE=		expect
VERSION=		${PORTVERSION}
EPOCH=			2
KEYWORDS=		lang
VARIANTS=		std
SDESC[std]=		Tool for automating interactive applications
HOMEPAGE=		https://core.tcl-lang.org/expect/
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
# SITES[main]=		SF/expect/Expect/${PORTVERSION} (use semi-official fork)
# SITES[main]=		https://www.tcl3d.org/bawt/download/InputLibs/
# DISTFILE[1]=		expect-5.45.4.1.7z:main
SITES[main]=		GITHUB/jrmarino:expect-fedora:${TAG}
DISTFILE[1]=		generated:main

SPKGS[std]=		set primary tools dev man

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		PUBDOM:primary
LICENSE_FILE=		PUBDOM:{{WRKSRC}}/license.terms
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		lang/expect

EXRUN[tools]=		primary

USES=			autoreconf cpe tcl:9.0,tea
CPE_VENDOR=		don_libes
CONFIGURE_ARGS=		--datadir={{PREFIX}}/share/expect
CFLAGS=			-Wno-incompatible-pointer-types
			-Wno-int-conversion
			-Wno-old-style-definition
			-Wno-unused-variable
			-Wno-unused-but-set-variable
			-std=gnu89
PLIST_SUB=		VERSION=${PORTVERSION}
			TCL_VER={{TCL_VER}}
DISTNAME=		expect-fedora-${PATCH_VERSION}/new-expect${PORTVERSION}

post-install:
	${LN} -sf tcl${TCL_VER}/expect${PORTVERSION}/libexpect${PORTVERSION}.so \
		${STAGEDIR}${PREFIX}/lib/libexpect.so.1
	${LN} -sf libexpect.so.1 ${STAGEDIR}${PREFIX}/lib/libexpect.so
