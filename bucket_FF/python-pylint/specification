DEF[PORTVERSION]=	4.1.3
# ------------------------------------------------------------------------

NAMEBASE=		python-pylint
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Python code static checker (3.14)
SDESC[v15]=		Python code static checker (3.15)
HOMEPAGE=		https://github.com/pylint-dev/pylint
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/3f/ba/62b18e2e157d05f976bd490b349b55d8850c2a454a5c313c91af9d2e0baf
DISTFILE[1]=		pylint-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		pylint-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# astroid<=4.4,>=4.3.4
# colorama>=0.4.5; sys_platform == "win32"
# dill>=0.2; python_version < "3.11"
# dill>=0.3.6; python_version >= "3.11"
# dill>=0.3.7; python_version >= "3.12"
# isort!=5.13,<10,>=5
# mccabe<0.8,>=0.6
# platformdirs>=2.2
# tomli>=1.1; python_version < "3.11"
# tomlkit>=0.10.1
# typing-extensions>=3.10; python_version < "3.10"
# pyenchant~=3.2; extra == "spelling"
# gitpython>3; extra == "testutils"

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-astroid:single:v14
					python-dill:single:v14
					python-isort:single:v14
					python-mccabe:single:v14
					python-platformdirs:single:v14
					python-tomlkit:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-astroid:single:v15
					python-dill:single:v15
					python-isort:single:v15
					python-mccabe:single:v15
					python-platformdirs:single:v15
					python-tomlkit:single:v15

BUILDRUN_DEPENDS=	python-pytest-runner:single:python_used
