DEF[PORTVERSION]=	3.1.1
# ------------------------------------------------------------------------

NAMEBASE=		python-pandas
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Data structures for time series, statistics (3.14)
SDESC[v15]=		Data structures for time series, statistics (3.15)
HOMEPAGE=		https://pandas.pydata.org
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/pandas
DISTFILE[1]=		pandas-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		pandas-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: meson-python>=0.19.0,<1
# build: Cython>3.1.0,<4
# build: numpy>=2.0.0,!=2.5.0
# build: versioneer[toml]
# buildrun: numpy>=2.0.2; python_version < '3.14'
# buildrun: numpy>=2.3.3; python_version >= '3.14'
# buildrun: python-dateutil>=2.9.0
# buildrun: tzdata; sys_platform == 'win32'
# buildrun: tzdata; sys_platform == 'emscripten'

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-meson-python:single:v14
					python-Cython:single:v14
					python-numpy:single:v14
					python-versioneer:single:v14
[PY314].BUILDRUN_DEPENDS_ON=		python-numpy:single:v14
					python-python-dateutil:single:v14
					python-tzdata:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-meson-python:single:v15
					python-Cython:single:v15
					python-numpy:single:v15
					python-versioneer:single:v15
[PY315].BUILDRUN_DEPENDS_ON=		python-numpy:single:v15
					python-python-dateutil:single:v15
					python-tzdata:single:v15

USES=			cpe c++:single
CPE_VENDOR=		numfocus
CPE_PRODUCT=		pandas
