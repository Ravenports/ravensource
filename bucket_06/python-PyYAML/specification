DEF[PORTVERSION]=	6.0.3
# ------------------------------------------------------------------------

NAMEBASE=		python-PyYAML
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		YAML parser and emitter for Python (3.14)
SDESC[v15]=		YAML parser and emitter for Python (3.15)
HOMEPAGE=		https://pyyaml.org/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/P/PyYAML
DISTFILE[1]=		pyyaml-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		pyyaml-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: Cython; python_version < '3.13'
# build: Cython>=3.0; python_version >= '3.13'

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-Cython:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-Cython:single:v15

USES=			cpe
CPE_VENDOR=		pyyaml
CPE_PRODUCT=		pyyaml
