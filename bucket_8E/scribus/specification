# Stable versions are 1.6.x, 1.8.x, etc
# Normally stick to stable, but make an exception for 1.7.x to
# hasten transition from Qt5 to Qt6
DEF[PORTVERSION]=	1.7.4
# ----------------------------------------------------------------------------

NAMEBASE=		scribus
VERSION=		${PORTVERSION}
KEYWORDS=		print editors
VARIANTS=		std
SDESC[std]=		Page Layout and Desktop Publishing
HOMEPAGE=		https://www.scribus.net/
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
# SITES[main]=		SF/scribus/scribus/${PORTVERSION}
SITES[main]=		SF/scribus/scribus-devel/${PORTVERSION}
DISTFILE[1]=		scribus-${PORTVERSION}.tar.xz:main

SPKGS[std]=		set primary dev man docs

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		GPLv2+:primary
LICENSE_FILE=		GPLv2+:stock
LICENSE_TERMS=		primary:{{WRKDIR}}/TERMS
LICENSE_SOURCE=		TERMS:{{WRKSRC}}/COPYING
LICENSE_AWK=		TERMS:"GNU GENERAL PUBLIC LICENSE"
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		print/scribus

BUILD_DEPENDS=		qt6-qttools:set:std
			qt6-qt5compat:dev:std
			qt6-qtsvg:dev:std
			poppler:dev:std
			poppler:cpp:std
			poppler:cppdev:std
			harfbuzz:dev:std
			lcms2:dev:std
			libcdr:dev:std
			boost-libraries:dev:std
			icu:dev:std
			librevenge:dev:std
			cups:dev:std
			cups:primary:std
			podofo:dev:std
			libwpg:dev:std
			hunspell:dev:std
			libvisio:dev:std
BUILDRUN_DEPENDS=	qt6-qtbase:primary:std
			qt6-qt5compat:primary:std
			qt6-qtsvg:primary:std
			lcms2:primary:std
			boost-libraries:primary:std
			hunspell:primary:std
			librevenge:primary:std
			libwpg:primary:std
			libcdr:primary:std
			libfreehand:single:std
			libpagemaker:single:std
			libmspub:single:std
			libvisio:primary:std
			poppler:primary:std
			podofo:primary:std
			icu:primary:std
			libqxp:single:std
			libzmf:single:std
			GraphicsMagick:primary:std
			harfbuzz:icu:std
RUN_DEPENDS=		cups:tools:std

USES=			cmake tiff png jpeg pkgconfig dos2unix ssl zlib
			python desktop-utils:primary mime-info:primary
			fontconfig execinfo c++:primary
GNOME_COMPONENTS=	libxml2 cairo
DOS2UNIX_REGEX=		.*\.(cpp|h|txt)
CMAKE_ARGS=		-DWANT_HUNSPELL=YES
			-DWANT_CPP17:BOOL=ON
			-DCMAKE_COLOR_MAKEFILE:BOOL=ON
			-DWANT_GRAPHICSMAGICK=1
			-DQT_PREFIX="{{LOCALBASE}}/lib/qt6"
			-DWITH_PODOFO:BOOL=OFF
			-DLIBPODOFO_CONFIG_H="{{LOCALBASE}}/include/podofo/auxiliary/podofo_config.h"
MAKE_ENV=		LANG=en_US.UTF-8

post-install:
	# remove duplicate license
	${RM} -r ${STAGEDIR}${PREFIX}/share/ads
	# strip
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/scribus
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/scribus/plugins/*.so
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/scribus/plugins/gettext/*.so
