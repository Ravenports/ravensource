OPTIONS_STANDARD=	none

# A version for FreeBSD exists, too, but let's start small
FPC_EQUIVALENT=		misc/ollama
ONLY_FOR_OPSYS=		linux

BUILD_DEPENDS=		golang:single:std
			ocl-icd:dev:std
			opencl-headers:single:std
BUILDRUN_DEPENDS=	ocl-icd:primary:std

USES=			c++:single cmake cpe python:build
CMAKE_ARGS=		-DOLLAMA_LLAMA_BACKENDS=""
			-DFETCHCONTENT_SOURCE_DIR_LLAMA_CPP=../llama.cpp-b10760
			-DGGML_OPENCL=ON

MAKE_ENV=		CGO_CPPFLAGS="{{CPPFLAGS}}"
			CGO_CFLAGS="{{CFLAGS}}"
			CGO_CXXFLAGS="{{CXXFLAGS}}"
			CGO_LDFLAGS="{{LDFLAGS}}"
			GOPATH="{{WRKSRC}}"
			GOFLAGS="-buildmode=pie '-ldflags=-linkmode=external -compressdwarf=false -X=github.com/ollama/ollama/version.Version=$pkgver -X=github.com/ollama/ollama/server.mode=release'"
INSTALL_REQ_TOOLCHAIN=	yes

PLIST_SUB=		GGML=${GGML}
			GGML_MAJ=${GGML:R:R}
			GGML_BASE=${GGML}
			GGML_BASE_MAJ=${GGML:R:R}
			LLAMA=${LLAMA}
			LLAMA_MAJ=${LLAMA:R:R}
			LLAMA_COMMON=${LLAMA}
			LLAMA_COMMON_MAJ=${LLAMA:R:R}
			MTMD=${LLAMA}
			MTMD_MAJ=${LLAMA:R:R}

post-patch:
	cd ${WRKDIR}/llama.cpp-b10760 && patch -i ${WRKSRC}/llama/compat/001-llama-cpp-hooks.patch
	${LN} -s ${WRKSRC}/vendor/github.com/apache/arrow/go/arrow+subdir/go/arrow ${WRKSRC}/vendor/github.com/apache/arrow/go/arrow
	${LN} -s ${WRKSRC}/vendor/github.com/bytedance/sonic/loader+subdir/loader ${WRKSRC}/vendor/github.com/bytedance/sonic/loader
	${LN} -s ${WRKSRC}/vendor/github.com/charmbracelet/x/ansi+subdir/ansi ${WRKSRC}/vendor/github.com/charmbracelet/x/ansi
	${LN} -s ${WRKSRC}/vendor/github.com/charmbracelet/x/cellbuf+subdir/cellbuf ${WRKSRC}/vendor/github.com/charmbracelet/x/cellbuf
	${LN} -s ${WRKSRC}/vendor/github.com/charmbracelet/x/term+subdir/term ${WRKSRC}/vendor/github.com/charmbracelet/x/term
	${LN} -s ${WRKSRC}/vendor/github.com/ugorji/go/codec+subdir/codec ${WRKSRC}/vendor/github.com/ugorji/go/codec
	${CP} ${FILESDIR}/modules.txt ${WRKSRC}/vendor/

# No idea why CMake installs the project twice; just delete the second one
post-stage:
	${RM} -r ${STAGEDIR}/construction
	cd ${STAGEDIR}${PREFIX}/lib/ollama && ${STRIP_CMD} *.so llama-quantize llama-server
