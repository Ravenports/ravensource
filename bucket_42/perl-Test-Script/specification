DEF[PORTVERSION]=	1.31
# ------------------------------------------------------------------------

NAMEBASE=		perl-Test-Script
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Basic cross-platform tests for scripts (5.42)
SDESC[544]=		Basic cross-platform tests for scripts (5.44)
HOMEPAGE=		https://github.com/uperl/Test-Script
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:P/PL/PLICEASE
DISTFILE[1]=		Test-Script-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Test-Script-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Capture::Tiny
# |      runtime : File::Spec (perl 5.42 core) (perl 5.44 core)
# |      runtime : IO::Handle (perl 5.42 core) (perl 5.44 core)
# |      runtime : Probe::Perl
# |      runtime : Test2::API (perl 5.42 core) (perl 5.44 core)
# |      runtime : Text::ParseWords (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : Test2::V0 (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Capture-Tiny:single:542
					perl-Probe-Perl:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Capture-Tiny:single:544
					perl-Probe-Perl:single:544

