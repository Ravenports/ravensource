DEF[PORTVERSION]=	1.24
# ------------------------------------------------------------------------

NAMEBASE=		perl-Net-Patricia
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Patricia Trie for fast IP address lookups (5.42)
SDESC[544]=		Patricia Trie for fast IP address lookups (5.44)
HOMEPAGE=		https://github.com/tobez/Net-Patricia
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:G/GR/GRUBER
DISTFILE[1]=		Net-Patricia-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# gpl_2, freebsd

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Net-Patricia-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Carp (perl 5.42 core) (perl 5.44 core)
# |      runtime : Exporter (perl 5.42 core) (perl 5.44 core)
# |      runtime : Net::CIDR::Lite
# |      runtime : Socket (perl 5.42 core) (perl 5.44 core)
# |      runtime : Socket6
# |      runtime : version (perl 5.42 core) (perl 5.44 core)
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : Storable (perl 5.42 core) (perl 5.44 core)
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Pod

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Net-CIDR-Lite:single:542
					perl-Socket6:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Net-CIDR-Lite:single:544
					perl-Socket6:single:544

