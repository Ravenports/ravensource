DEF[PORTVERSION]=	EXTRACT_INFO(SUBVERSION_VERSION)
DEF[SVNREPOS]=		srv/svn/repos
# ----------------------------------------------------------------------------

NAMEBASE=		subversion
VERSION=		${PORTVERSION}
KEYWORDS=		devel
VARIANTS=		std
SDESC[std]=		Version control system
HOMEPAGE=		https://subversion.apache.org/
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
SITES[main]=		APACHE/subversion
DISTFILE[1]=		subversion-${PORTVERSION}.tar.bz2:main

SPKGS[std]=		set primary dev nls man

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		APACHE20:primary
LICENSE_FILE=		APACHE20:{{WRKSRC}}/LICENSE
LICENSE_TERMS=		primary:{{WRKSRC}}/NOTICE
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		devel/subversion

BUILD_DEPENDS=		apr-util:dev:std
			apr1:dev:std
			utf8proc:dev:std
BUILDRUN_DEPENDS=	apr-util:primary:std
			apr1:primary:std
			serf:single:std
			utf8proc:primary:std

USERS=			svn
GROUPS=			svn
USERGROUP_SPKG=		primary

RC_SUBR=		svnserve:primary

USES=			cpe cmake pkgconfig gettext zlib iconv
			sqlite expat:build shebangfix
			smf:primary
CPE_VENDOR=		apache
SMF_NAME=		svnserve
SHEBANG_OLD_PYTHON=	{{LOCALBASE}}/bin/python2
			"/bin/env python"
SHEBANG_REGEX=		./tools/.*
SHEBANG_FILES=		tools/server-side/svnpubsub/rc.d/svnpubsub.solaris
			tools/server-side/svnpubsub/rc.d/svnwcsub.solaris
CMAKE_ARGS=		-DSVN_ENABLE_PROGRAMS:BOOL=ON
			-DSVN_ENABLE_NLS:BOOL=ON
			-DSVN_ENABLE_SWIG_PERL:BOOL=OFF
			-DSVN_ENABLE_SWIG_PYTHON:BOOL=OFF
			-DSVN_ENABLE_SWIG_RUBY:BOOL=OFF
			-DSVN_ENABLE_AUTH_KWALLET:BOOL=OFF
SUB_FILES=		manifest.xml
SUB_LIST=		SVN_USR={{USERS}}
			SVN_GRP={{GROUPS}}
			SVN_REPOS=${SVNREPOS}
PLIST_SUB=		OWN={{USERS}}
			GRP={{GROUPS}}
			REPOS_DIR=${SVNREPOS}

VAR_OPSYS[sunos]=	CFLAGS=-D__EXTENSIONS__
# #			CONFIGURE_ENV=ac_cv_search_bindtextdomain="-lintl"

pre-configure:
	${REINPLACE_CMD} "s#/etc/subversion#${PREFIX}/etc/subversion#g" ${WRKSRC}/subversion/libsvn_subr/config_file.c
	${REINPLACE_CMD} "s#/etc/subversion#${PREFIX}/etc/subversion#g" ${WRKSRC}/subversion/libsvn_subr/config_impl.h
	# remove all .bak files to clean the stage
	${FIND} ${WRKSRC} -name '*.bak' -delete

post-install:
	${MKDIR} ${STAGEDIR}${PREFIX}/var/run/subversion
	${MKDIR} ${STAGEDIR}${PREFIX}/${SVNREPOS}

	# CMake doesn't know how to install man pages
.for page in svn svnadmin svndumpfilter svnlook svnmucc svnrdump svnsync svnversion
	${INSTALL_MAN} ${WRKSRC}/subversion/${page}/${page}.1 \
		${STAGEDIR}${PREFIX}/share/man/man1/
.endfor
	${INSTALL_MAN} ${WRKSRC}/subversion/svnserve/svnserve.conf.5 \
		${STAGEDIR}${PREFIX}/share/man/man5/
	${INSTALL_MAN} ${WRKSRC}/subversion/svnserve/svnserve.8 \
		${STAGEDIR}${PREFIX}/share/man/man8/

	# strip
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/svn*
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/*.so
