DEF[PORTVERSION]=	1.12
DEF[SOVERSION]=		5.6
# ----------------------------------------------------------------------------

NAMEBASE=		libzip
VERSION=		${PORTVERSION}
KEYWORDS=		archivers
VARIANTS=		std
SDESC[std]=		C library for manipulating ZIP archives
HOMEPAGE=		http://www.nih.at/libzip/
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
SITES[main]=		http://www.nih.at/libzip/
DISTFILE[1]=		libzip-${PORTVERSION}.tar.xz:main

SPKGS[std]=		set primary tools dev man

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		BSD3CLAUSE:primary
LICENSE_FILE=		BSD3CLAUSE:{{WRKSRC}}/LICENSE
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		archivers/libzip

EXRUN[tools]=		primary

BUILD_DEPENDS=		mandoc:primary:std

USES=			cpe cmake zlib bz2 xz ssl bfd
CMAKE_ARGS=		--debug-trycompile
SOVERSION=		${SOVERSION}
SINGLE_JOB=		yes

post-patch:
	# ${REINPLACE_CMD} -e '/SET(CMAKE_INSTALL_RPATH /d' \
		${WRKSRC}/CMakeLists.txt

post-install:
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/zip*
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/libzip.so
