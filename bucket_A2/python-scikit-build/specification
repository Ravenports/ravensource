KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Generator for c/c++/fortran extensions (3.14)
SDESC[v15]=		Generator for c/c++/fortran extensions (3.15)
HOMEPAGE=		https://github.com/scikit-build/scikit-build
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/47/ef/53c5d9293d1d11ed4e682fdd7f32c776b79ee30f83757395db0d4d0f0276
DISTFILE[1]=		scikit_build-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
