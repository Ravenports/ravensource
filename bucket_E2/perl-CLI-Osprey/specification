DEF[PORTVERSION]=	0.09
# ------------------------------------------------------------------------

NAMEBASE=		perl-CLI-Osprey
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		MooX::Options + MooX::Cmd + Sanity (5.42)
SDESC[544]=		MooX::Options + MooX::Cmd + Sanity (5.44)
HOMEPAGE=		https://github.com/arodland/CLI-Osprey
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:A/AR/ARODLAND
DISTFILE[1]=		CLI-Osprey-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		CLI-Osprey-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Getopt::Long::Descriptive
# |      runtime : Module::Runtime
# |      runtime : Moo
# |      runtime : Moo::Role
# |      runtime : Path::Tiny
# |    configure : Module::Build::Tiny
# |         test : Capture::Tiny
# |         test : Test::Lib
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,buildmodtiny,run
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Getopt-Long-Descriptive:single:542
					perl-Module-Runtime:single:542
					perl-Moo:single:542
					perl-Path-Tiny:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-Module-Build-Tiny:single:542
[PERL_544].USES_ON=			perl:544,buildmodtiny,run
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Getopt-Long-Descriptive:single:544
					perl-Module-Runtime:single:544
					perl-Moo:single:544
					perl-Path-Tiny:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-Module-Build-Tiny:single:544

