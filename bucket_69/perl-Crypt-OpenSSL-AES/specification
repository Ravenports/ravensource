# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Exporter (perl 5.42 core) (perl 5.44 core)
# |      runtime : XSLoader (perl 5.42 core) (perl 5.44 core)
# |        build : Crypt::OpenSSL::Guess
# |    configure : Crypt::OpenSSL::Guess
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |         test : Crypt::OpenSSL::Guess
# |         test : Crypt::URandom
# |         test : Digest::SHA (perl 5.42 core) (perl 5.44 core)
# |         test : MIME::Base64 (perl 5.42 core) (perl 5.44 core)
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILD_DEPENDS_ON=		perl-Crypt-OpenSSL-Guess:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILD_DEPENDS_ON=		perl-Crypt-OpenSSL-Guess:single:544

USES=			ssl
MAKE_ARGS=		OTHERLDFLAGS="{{LDFLAGS}}"
