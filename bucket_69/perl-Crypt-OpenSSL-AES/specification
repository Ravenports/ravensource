VARIANTS=		542 544
SDESC[542]=		Wrapper around OpenSSL's AES library (5.42)
SDESC[544]=		Wrapper around OpenSSL's AES library (5.44)
HOMEPAGE=		https://github.com/perl-openssl/perl-Crypt-OpenSSL-AES
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:T/TI/TIMLEGGE
