DEF[PORTVERSION]=	2.0.3
# ------------------------------------------------------------------------

NAMEBASE=		python-ioflo
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Flow Programming Automated Reasoning Engine (3.14)
SDESC[v15]=		Flow Programming Automated Reasoning Engine (3.15)
HOMEPAGE=		https://github.com/ioflo/ioflo
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/i/ioflo
DISTFILE[1]=		ioflo-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Apache 2.0

GENERATED=		yes
DISTNAME=		ioflo-${PORTVERSION}

# install_requires extracted from setup.py
# setuptools_git >= 1.1

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-setuptools-git:single:v14
[PY315].USES_ON=			python:v15,sutools
[PY315].BUILDRUN_DEPENDS_ON=		python-setuptools-git:single:v15

