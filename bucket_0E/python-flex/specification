DEF[PORTVERSION]=	6.14.1
# ------------------------------------------------------------------------

NAMEBASE=		python-flex
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Swagger Schema validation (3.14)
SDESC[v15]=		Swagger Schema validation (3.15)
HOMEPAGE=		https://github.com/pipermerriam/flex
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/f/flex
DISTFILE[1]=		flex-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# BSD

GENERATED=		yes
DISTNAME=		flex-${PORTVERSION}

# install_requires extracted from setup.py
# six>=1.7.3
# PyYAML>=3.11
# validate-email>=1.2
# rfc3987>=1.3.4
# requests>=2.4.3
# strict-rfc3339>=0.7
# click>=3.3
# jsonpointer>=1.7

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-six:single:v14
					python-PyYAML:single:v14
					python-validate_email:single:v14
					python-rfc3987:single:v14
					python-requests:single:v14
					python-strict-rfc3339:single:v14
					python-click:single:v14
					python-jsonpointer:single:v14
[PY315].USES_ON=			python:v15,sutools
[PY315].BUILDRUN_DEPENDS_ON=		python-six:single:v15
					python-PyYAML:single:v15
					python-validate_email:single:v15
					python-rfc3987:single:v15
					python-requests:single:v15
					python-strict-rfc3339:single:v15
					python-click:single:v15
					python-jsonpointer:single:v15

