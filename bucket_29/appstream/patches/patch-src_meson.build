Work around multibyte bug on NetBSD (standards/60369)

--- src/meson.build.orig	2026-09-28 17:53:27 UTC
+++ src/meson.build
@@ -256,6 +256,7 @@ pc_fixup = run_command(sed_prog,
                        '-e', '/^Requires\.private/ d',
                        '-e', '/^Libs\.private/ d',
                        meson.global_build_root() / 'meson-private' / 'appstream.pc',
+                       env: {'LC_ALL': 'C'},
                        check: false)
 if pc_fixup.returncode() != 0
     error('Unable to fix up the .pc file:\n' + pc_fixup.stderr())
