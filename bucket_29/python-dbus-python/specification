BUILD_DEPENDS=		dbus:dev:std
BUILDRUN_DEPENDS=	dbus:primary:std

USES=			meson pkgconfig
GNOME_COMPONENTS=	glib

[PY315].MAKE_ENV_ON=			AUTOPYTHON=3.15
[PY315].BUILD_DEPENDS_ON=		python-wheel:single:v15
					python-setuptools:single:v15

