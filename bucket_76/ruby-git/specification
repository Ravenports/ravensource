DEF[PORTVERSION]=	5.1.0
# ------------------------------------------------------------------------

NAMEBASE=		ruby-git
VERSION=		${PORTVERSION}
KEYWORDS=		ruby
VARIANTS=		v33 v34 v40
SDESC[v33]=		Wraps system calls to the git library (v33)
SDESC[v34]=		Wraps system calls to the git library (v34)
SDESC[v40]=		Wraps system calls to the git library (v40)
HOMEPAGE=		https://github.com/ruby-git/ruby-git
CONTACT=		Ruby_Automaton[ruby@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		RUBYGEMS/
DISTFILE[1]=		git-5.1.0.gem:main
DIST_SUBDIR=		ruby

SPKGS[v33]=		single
SPKGS[v34]=		single
SPKGS[v40]=		single

OPTIONS_AVAILABLE=	RUBY33 RUBY34 RUBY40
OPTIONS_STANDARD=	none
VOPTS[v33]=		RUBY33=ON RUBY34=OFF RUBY40=OFF
VOPTS[v34]=		RUBY33=OFF RUBY34=ON RUBY40=OFF
VOPTS[v40]=		RUBY33=OFF RUBY34=OFF RUBY40=ON

# License listed inside gem specification
# => UNSET

# Requirements according to gem specification:
#   activesupport (>= 5.0)
#   addressable (~> 2.8)
#   process_executer (~> 4.0)
#   rchardet (~> 1.9)
#   create_github_release (~> 2.1, development)
#   fuubar (~> 2.5, development)
#   irb (~> 1.16, development)
#   main_branch_shared_rubocop_config (~> 0.1, development)
#   parallel_tests (~> 5.6, development)
#   rake (~> 13.3, development)
#   redcarpet (~> 3.6, development)
#   rspec (~> 3.13, development)
#   rubocop (~> 1.82, development)
#   simplecov (~> 1.0, development)
#   simplecov-lcov (~> 0.9, development)
#   simplecov-rspec (~> 1.1, development)
#   yard (~> 0.9, >= 0.9.28, development)
#   yard_example_test (~> 0.2, >= 0.2.1, development)
#   yard-lint (~> 1.8, development)

DISTNAME=		git-${PORTVERSION}
GENERATED=		yes

[RUBY33].USES_ON=			gem:v33
[RUBY33].BUILDRUN_DEPENDS_ON=		ruby-activesupport:single:v33
					ruby-addressable:single:v33
					ruby-process_executer:single:v33
					ruby-rchardet:single:v33
[RUBY34].USES_ON=			gem:v34
[RUBY34].BUILDRUN_DEPENDS_ON=		ruby-activesupport:single:v34
					ruby-addressable:single:v34
					ruby-process_executer:single:v34
					ruby-rchardet:single:v34
[RUBY40].USES_ON=			gem:v40
[RUBY40].BUILDRUN_DEPENDS_ON=		ruby-activesupport:single:v40
					ruby-addressable:single:v40
					ruby-process_executer:single:v40
					ruby-rchardet:single:v40

USES=			cpe
CPE_VENDOR=		ruby-git_project
CPE_PRODUCT=		ruby-git
