DEF[PORTVERSION]=	2.5.5
# ------------------------------------------------------------------------

NAMEBASE=		python-markdown2
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Complete implementation of Markdown (3.14)
SDESC[v15]=		Complete implementation of Markdown (3.15)
HOMEPAGE=		https://github.com/trentm/python-markdown2
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/43/af/4b3891eb0a49d6cfd5cbf3e9bf514c943afc2b0f13e2c57cc57cd88ecc21
DISTFILE[1]=		markdown2-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
