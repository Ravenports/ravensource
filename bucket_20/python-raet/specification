DEF[PORTVERSION]=	0.6.8
# ------------------------------------------------------------------------

NAMEBASE=		python-raet
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Reliable Asynchronous Event Transport (3.14)
SDESC[v15]=		Reliable Asynchronous Event Transport (3.15)
HOMEPAGE=		https://github.com/RaetProtocol/raet.git
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/r/raet
DISTFILE[1]=		raet-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Apache2

GENERATED=		yes
DISTNAME=		raet-${PORTVERSION}

# install_requires extracted from setup.py
# ioflo>=1.2.4
# libnacl>=1.4.3
# six>=1.6.1
# setuptools_git >= 1.1

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-ioflo:single:v14
					python-libnacl:single:v14
					python-six:single:v14
					python-setuptools-git:single:v14
[PY315].USES_ON=			python:v15,sutools
[PY315].BUILDRUN_DEPENDS_ON=		python-ioflo:single:v15
					python-libnacl:single:v15
					python-six:single:v15
					python-setuptools-git:single:v15

