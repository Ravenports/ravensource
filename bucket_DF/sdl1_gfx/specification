DEF[PORTVERSION]=	2.0.28
DEF[SOVERSION]=		16.9.2
DEF[TAG]=		v${PORTVERSION}
# ----------------------------------------------------------------------------

NAMEBASE=		sdl1_gfx
VERSION=		${PORTVERSION}
KEYWORDS=		graphics
VARIANTS=		std
SDESC[std]=		SDL drawing primitives & other support functions
HOMEPAGE=		https://www.ferzkopp.net/Software/SDL_gfx-2.0/
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		GITHUB/ferzkopp:SDL_gfx:${TAG}
DISTFILE[1]=		generated:main

SPKGS[std]=		set primary dev

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		ZLIB:primary
LICENSE_FILE=		ZLIB:{{WRKSRC}}/LICENSE
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		graphics/sdl_gfx

USES=			cmake
SDL_COMPONENTS=		sdl1
SOVERSION=		${SOVERSION}
CMAKE_ARGS=		-DSDLGFX_DEMOS:BOOL=OFF
			-DSDLGFX_TESTS:BOOL=OFF
			-DSDLGFX_WERROR:BOOL=OFF
			-DSDLGFX_DOCS:BOOL=OFF

post-install:
	# remove duplicate license
	${RM} -r ${STAGEDIR}${PREFIX}/share/licenses
