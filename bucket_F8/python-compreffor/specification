DEF[PORTVERSION]=	0.6.0
# ------------------------------------------------------------------------

NAMEBASE=		python-compreffor
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		CFF subroutinizer for fontTools (3.14)
SDESC[v15]=		CFF subroutinizer for fontTools (3.15)
HOMEPAGE=		none
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/c/compreffor
DISTFILE[1]=		compreffor-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Apache 2.0

GENERATED=		yes
DISTNAME=		compreffor-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: setuptools_scm
# build: setuptools_git_ls_files
# build: cython

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-setuptools-scm:single:v14
					python-setuptools-git-ls-files:single:v14
					python-Cython:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-setuptools-scm:single:v15
					python-setuptools-git-ls-files:single:v15
					python-Cython:single:v15

USES=			c++:single
BUILD_DEPENDS=		python-setuptools-git-ls-files:single:python_used
			python-setuptools-scm:single:python_used
