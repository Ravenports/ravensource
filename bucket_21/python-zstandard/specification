DEF[PORTVERSION]=	0.25.0
# ------------------------------------------------------------------------

NAMEBASE=		python-zstandard
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Zstandard bindings for Python (3.14)
SDESC[v15]=		Zstandard bindings for Python (3.15)
HOMEPAGE=		https://github.com/indygreg/python-zstandard
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/z/zstandard
DISTFILE[1]=		zstandard-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		zstandard-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: cffi~=1.17; platform_python_implementation != 'PyPy' and python_version < '3.14'
# build: cffi>=2.0.0b; platform_python_implementation != 'PyPy' and python_version >= '3.14'
# build: packaging

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-cffi:single:v14
					python-packaging:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-cffi:single:v15
					python-packaging:single:v15

INSTALL_REQ_TOOLCHAIN=	yes
