DEF[PORTVERSION]=	2.0.0
# ------------------------------------------------------------------------

NAMEBASE=		python-evdev
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Linux input handling subsystem bindings (3.14)
SDESC[v15]=		Linux input handling subsystem bindings (3.15)
HOMEPAGE=		https://github.com/gvalkov/python-evdev
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/e/evdev
DISTFILE[1]=		evdev-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		evdev-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file


[PY314].USES_ON=			python:v14,pep517
[PY315].USES_ON=			python:v15,pep517

ONLY_FOR_OPSYS=		dragonfly freebsd linux midnightbsd

USES=			clang cclibs:single
BUILD_DEPENDS=		evdev-proto:single:std

pre-configure-dragonfly:
	${REINPLACE_CMD} -e 's#/usr/include#${LOCALBASE}/include#' \
		${WRKSRC}/setup.py ${WRKSRC}/src/evdev/genecodes_c.py

pre-configure-freebsd:
	${REINPLACE_CMD} -e 's#/usr/include#${LOCALBASE}/include#' \
		${WRKSRC}/setup.py ${WRKSRC}/src/evdev/genecodes_c.py

pre-configure-midnightbsd:
	${REINPLACE_CMD} -e 's#/usr/include#${LOCALBASE}/include#' \
		${WRKSRC}/setup.py ${WRKSRC}/src/evdev/genecodes_c.py
