DEF[PORTVERSION]=	2.3
# ------------------------------------------------------------------------

NAMEBASE=		python-promise
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Promises/A+ implementation for Python (3.14)
SDESC[v15]=		Promises/A+ implementation for Python (3.15)
HOMEPAGE=		https://github.com/syrusakbary/promise
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/promise
DISTFILE[1]=		promise-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
