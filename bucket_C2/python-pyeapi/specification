DEF[PORTVERSION]=	1.0.4
# ------------------------------------------------------------------------

NAMEBASE=		python-pyeapi
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Python Client for eAPI (3.14)
SDESC[v15]=		Python Client for eAPI (3.15)
HOMEPAGE=		https://github.com/arista-eosplus/pyeapi
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/pyeapi
DISTFILE[1]=		pyeapi-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# BSD-3

GENERATED=		yes
DISTNAME=		pyeapi-${PORTVERSION}

# install_requires extracted from setup.py
# netaddr

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-netaddr:single:v14
