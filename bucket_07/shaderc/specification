DEF[PORTVERSION]=	2026.2
# ----------------------------------------------------------------------------

NAMEBASE=		shaderc
VERSION=		${PORTVERSION}
KEYWORDS=		graphics devel
VARIANTS=		std
SDESC[std]=		GLSL/HLSL to SPIR-V shader compiler
HOMEPAGE=		https://github.com/google/shaderc
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		GITHUB/google:shaderc:v${PORTVERSION}
DISTFILE[1]=		generated:main

SPKGS[std]=		set primary dev

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		APACHE20:primary
LICENSE_FILE=		APACHE20:{{WRKSRC}}/LICENSE
LICENSE_TERMS=		primary:{{WRKDIR}}/TERMS
LICENSE_SOURCE=		TERMS:{{WRKSRC}}/glslc/src/file.h
LICENSE_AWK=		TERMS:"ifndef GLSLC_FILE_H_"
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		graphics/shaderc

BUILD_DEPENDS=		glslang:set:std
			spirv-headers:single:std
			spirv-tools:set:std

USES=			c++:primary cmake python:build

CMAKE_ARGS=		-DSHADERC_SKIP_TESTS=ON
			-Dglslang_SOURCE_DIR:PATH={{PREFIX}}/include/glslang

post-patch:
	# De-vendoring
	${REINPLACE_CMD} '/examples/d;/third_party/d' ${WRKSRC}/CMakeLists.txt
	# Derive version from ports rather than git repository
	${REINPLACE_CMD} '/build-version/d' ${WRKSRC}/glslc/CMakeLists.txt
	${ECHO_CMD} "\"${PORTNAME} ${DISTVERSIONFULL}\n\"" >> ${WRKSRC}/glslc/src/build-version.inc
	${ECHO_CMD} "\"`${PKG_BIN} query '%n v%v' spirv-tools`\n\"" >> ${WRKSRC}/glslc/src/build-version.inc
	${ECHO_CMD} "\"`${PKG_BIN} query '%n %v' glslang`\n\"" >> ${WRKSRC}/glslc/src/build-version.inc

post-install:
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/glslc
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/libshaderc_shared.so.1
