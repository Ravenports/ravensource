DEF[PORTVERSION]=	1.5.1
DEF[SOVERSION]=		4.0.0
# ----------------------------------------------------------------------------

NAMEBASE=		libbluray
VERSION=		${PORTVERSION}
REVISION=		1
KEYWORDS=		multimedia
VARIANTS=		std
SDESC[std]=		Blu-Ray discs playback library for media players
HOMEPAGE=		https://www.videolan.org/developers/libbluray.html
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		https://code.videolan.org/videolan/libbluray/-/archive/${PORTVERSION}/
DISTFILE[1]=		libbluray-${PORTVERSION}.tar.bz2:main

SPKGS[std]=		set primary tools dev

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		LGPL21+:primary
LICENSE_FILE=		LGPL21+:{{WRKSRC}}/COPYING
LICENSE_TERMS=		primary:{{WRKDIR}}/TERMS
LICENSE_SOURCE=		TERMS:{{WRKSRC}}/src/libbluray/bluray.h
LICENSE_AWK=		TERMS:"^$$"
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		multimedia/libbluray

BUILD_DEPENDS=		libudfread:dev:std
BUILDRUN_DEPENDS=	libudfread:primary:std

EXRUN[dev]=		libudfread:dev:std
			libxml2:dev:std
			freetype:dev:std
			fontconfig:dev:std

USES=			cpe fontconfig freetype pkgconfig meson
GNOME_COMPONENTS=	libxml2
CPE_VENDOR=		videolan

# Building documentation not only requires doxygen, perl and graphviz but
# also LaTeX! Since we only have the fat TeXLive distribution that's a
# bit much.

MESON_ARGS=		-Dbdj_jar=disabled
			-Denable_docs=false

SOVERSION=		${SOVERSION}

EXRUN[tools]=		libbluray:primary:std
