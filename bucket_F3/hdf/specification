DEF[PORTVERSION]=	4.4.0
DEF[SOVERSION]=		11.0.0
DEF[MF_SOVERSION]=	11.0.0
# ----------------------------------------------------------------------------

NAMEBASE=		hdf
VERSION=		${PORTVERSION}
KEYWORDS=		science archivers graphics
VARIANTS=		std
SDESC[std]=		HDF4 Hierarchical Data Format
HOMEPAGE=		https://www.hdfgroup.org/solutions/hdf4/
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
SITES[main]=		https://github.com/HDFGroup/hdf4/releases/download/hdf${PORTVERSION}/
DISTFILE[1]=		hdf${PORTVERSION}.tar.gz:main

SPKGS[std]=		set primary dev tools

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

FPC_EQUIVALENT=		science/hdf

LICENSE=		BSD3CLAUSE:primary
LICENSE_FILE=		BSD3CLAUSE:{{WRKSRC}}/COPYING
LICENSE_SCHEME=		solo

EXRUN[tools]=		primary

USES=			cmake jpeg zlib
DISTNAME=		hdf${PORTVERSION}
SOVERSION=		${SOVERSION}
PLIST_SUB=		MF_SOVERSION=${MF_SOVERSION}
			MF_SOMAJOR=${MF_SOVERSION:R:R}

post-install:
	${RM} ${STAGEDIR}${PREFIX}/share/COPYING
	${RM} ${STAGEDIR}${PREFIX}/share/RELEASE.txt
	${RM} ${STAGEDIR}${PREFIX}/share/USING_HDF4_CMake.txt
	# strip
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/libhdf.so
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/libmfhdf.so
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/h[dr]*
