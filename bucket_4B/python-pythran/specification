# Requires-Dist extracted from wheel metadata
# ply>=3.4
# setuptools<60; python_version < "3.12"
# setuptools; python_version >= "3.12"
# gast~=0.7.0
# numpy
# beniget~=0.5.0
# numpy; extra == "doc"
# nbsphinx; extra == "doc"
# scipy; extra == "doc"
# guzzle_sphinx_theme; extra == "doc"
# ipython; extra == "test"
# nbval; extra == "test"
# cython; extra == "test"
# wheel; extra == "test"
# packaging; extra == "test"
# ninja; extra == "test"
# meson; extra == "test"

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-ply:single:v14
					python-setuptools:single:v14
					python-gast:single:v14
					python-numpy:single:v14
					python-beniget:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-ply:single:v15
					python-setuptools:single:v15
					python-gast:single:v15
					python-numpy:single:v15
					python-beniget:single:v15

