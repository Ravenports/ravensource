DEF[PORTVERSION]=	0.3.2
DEF[TAG]=		luarocks-build-luke-v${PORTVERSION}
# ----------------------------------------------------------------------------

NAMEBASE=		luarocks-build-luke
VERSION=		${PORTVERSION}
KEYWORDS=		devel
VARIANTS=		lua52 lua53 lua54 lua55
SDESC[lua52]=		LuaRocks build backend for luke (lua 5.2)
SDESC[lua53]=		LuaRocks build backend for luke (lua 5.3)
SDESC[lua54]=		LuaRocks build backend for luke (lua 5.4)
SDESC[lua55]=		LuaRocks build backend for luke (lua 5.5)
HOMEPAGE=		none
CONTACT=		nobody

DOWNLOAD_GROUPS=	main
SITES[main]=		GITHUB/gvvaughan:luke:${TAG}
DISTFILE[1]=		generated:main

SPKGS[lua52]=		single
SPKGS[lua53]=		single
SPKGS[lua54]=		single
SPKGS[lua55]=		single

OPTIONS_AVAILABLE=	LUA52 LUA53 LUA54 LUA55
OPTIONS_STANDARD=	none
VOPTS[lua52]=		LUA52=ON LUA53=OFF LUA54=OFF LUA55=OFF
VOPTS[lua53]=		LUA52=OFF LUA53=ON LUA54=OFF LUA55=OFF
VOPTS[lua54]=		LUA52=OFF LUA53=OFF LUA54=ON LUA55=OFF
VOPTS[lua55]=		LUA52=OFF LUA53=OFF LUA54=OFF LUA55=ON

FPC_EQUIVALENT=		devel/lua-luarocks-build-luke

SKIP_BUILD=		yes

[LUA52].DESCRIPTION=			Build with Lua 5.2
[LUA52].USES_ON=			lua:5.2,tools

[LUA53].DESCRIPTION=			Build with Lua 5.3
[LUA53].USES_ON=			lua:5.3,tools

[LUA54].DESCRIPTION=			Build with Lua 5.4
[LUA54].USES_ON=			lua:5.4,tools

[LUA55].DESCRIPTION=			Build with Lua 5.5
[LUA55].USES_ON=			lua:5.5,tools

do-install:
	${MKDIR} ${STAGEDIR}${LUA_MODSHAREDIR}/luarocks/build
	${INSTALL_DATA} ${WRKSRC}/build-aux/luarocks-build-luke.lua \
		${STAGEDIR}${LUA_MODSHAREDIR}/luarocks/build/luke.lua
