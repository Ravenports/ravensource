@sample etc/avahi/avahi-daemon.conf.sample
@sample etc/avahi/hosts.sample
%%ONLY-LINUX%%etc/init.d/avahi-daemon
%%ONLY-LINUX%%etc/init.d/avahi-dnsconfd
bin/avahi-browse
bin/avahi-browse-domains
bin/avahi-publish
bin/avahi-publish-address
bin/avahi-publish-service
bin/avahi-resolve
bin/avahi-resolve-address
bin/avahi-resolve-host-name
bin/avahi-set-host-name
etc/avahi/avahi-dnsconfd.action
etc/avahi/services/sftp-ssh.service
etc/avahi/services/ssh.service
sbin/avahi-daemon
sbin/avahi-dnsconfd
share/dbus-1/system.d/avahi-dbus.conf
@dir(%%OWN%%,%%GRP%%,0750) var/run/avahi-daemon
