# 1.6.x RC2, moved to release candidate for Qt6
DEF[PORTVERSION]=	1.6.1001
DEF[SOVERSION]=		1.6.0
DEF[FOLDER]=		v1.6.0-alpha2
# ----------------------------------------------------------------------------

NAMEBASE=		mumble
VERSION=		${PORTVERSION}
KEYWORDS=		audio
VARIANTS=		std
SDESC[std]=		Low latency, high quality voice chat software
HOMEPAGE=		https://www.mumble.info/
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		https://github.com/mumble-voip/mumble/releases/download/${FOLDER}/
DISTFILE[1]=		mumble-${PORTVERSION}.tar.gz:main

SPKGS[std]=		set client server man

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

LICENSE=		BSD3CLAUSE:client
LICENSE_FILE=		BSD3CLAUSE:{{WRKSRC}}/LICENSE
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		audio/mumble

BUILD_DEPENDS=		avahi:dev:std
			avahi:libdnsdev:std
			boost-libraries:dev:std
			libglvnd:dev:std
			libsndfile:dev:std
			ms-gsl:single:std
			nlohmann-json:single:std
			poco:dev:std
			protobuf:dev:std
			qt6-qtbase:dev:std
			qt6-qtsvg:dev:std
			qt6-qttools:dev:std
			qt6-qt5compat:dev:std
			speexdsp:dev:std
			utf8proc:dev:std
BUILDRUN_DEPENDS=	avahi:primary:std
			avahi:libdns:std
			boost-libraries:primary:std
			libglvnd:primary:std
			libsndfile:primary:std
			poco:primary:std
			protobuf:primary:std
			qt6-qtbase:primary:std
			qt6-qtsvg:primary:std
			qt6-qttools:primary:std
			qt6-qt5compat:primary:std
			speexdsp:primary:std
			utf8proc:primary:std

USES=			cmake desktop-utils:client execinfo expat gmake pcre2
			pkgconfig python:build shebangfix ssl zlib cpe sqlite
XORG_COMPONENTS=	x11 xext xi

B_DEPS[linux]=		alsa-lib:dev:std
BR_DEPS[linux]=		alsa-lib:primary:std

CMAKE_ARGS=		-DCMAKE_PREFIX_PATH={{PREFIX}}/lib/qt6/cmake
			-Doverlay-xcompile=off
			-Dice=off
			-Dbundled-json=off
			-Dbundled-speex=off
			-Dbundle-qt-translations=off
			-Dcrash-report=off
			-Dg15=off
			-Dserver=on
			-Dtracy=off
			-Dupdate=off
			-Dclient=on
			-Doverlay=on
			-Dplugins=on
			-Dtranslations=on
			-Dxinput2=on
			-Doss=on
			-Dspeechd=off
			-Dpulseaudio=off
			-Dpipewire=off
			-Dtests=off
			-Dbenchmarks=off
			-Denable-mysql=off
			-Denable-postgresql=off
			-Denable-sqlite=on

SHEBANG_FILES=		auxiliary_files/run_scripts/mumble-overlay.in
CONFIGURE_ENV=		MUMBLE_PYTHON={{PYTHON_CMD}}
INSTALL_REQ_TOOLCHAIN=	yes
CXXFLAGS=		-Wno-error=deprecated-declarations
SOVERSION=		${SOVERSION}

post-install:
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/mumble
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/bin/mumble-server
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/mumble/plugins/liblink.so
	${STRIP_CMD} ${STAGEDIR}${PREFIX}/lib/mumble/libmumbleoverlay.so.${SOVERSION}

post-install-linux:
	(cd ${STAGEDIR}${PREFIX}/etc/sysusers.d && \
		${MV} mumble-server.conf mumble-server.conf.sample)
	(cd ${STAGEDIR}${PREFIX}/etc/tmpfiles.d && \
		${MV} mumble-server.conf mumble-server.conf.sample)
