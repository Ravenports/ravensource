DEF[PORTVERSION]=	3.5.22
# ------------------------------------------------------------------------

NAMEBASE=		python-netdoc
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Network documentation plugin for NetBox (3.14)
SDESC[v15]=		Network documentation plugin for NetBox (3.15)
HOMEPAGE=		none
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/n/netdoc
DISTFILE[1]=		netdoc-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# GNU v3.0

GENERATED=		yes
DISTNAME=		netdoc-${PORTVERSION}

# install_requires extracted from setup.py
# ipaddress==1.0.23
# jsonschema==3.2.0
# macaddress==2.0.2
# n2g==0.3.3
# netmiko==4.1.2
# nornir==3.3.0
# nornir_netmiko==0.2.0
# nornir_utils
# ouilookup==0.2.4
# python-slugify
# pyvmomi==8.0.1.0.1
# xmltodict==0.13.0

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-ipaddress:single:v14
					python-jsonschema:single:v14
					python-macaddress:single:v14
					python-n2g:single:v14
					python-netmiko:single:v14
					python-nornir:single:v14
					python-nornir-netmiko:single:v14
					python-nornir-utils:single:v14
					python-ouilookup:single:v14
					python-python-slugify:single:v14
					python-pyvmomi:single:v14
					python-xmltodict:single:v14
[PY315].USES_ON=			python:v15,sutools
[PY315].BUILDRUN_DEPENDS_ON=		python-ipaddress:single:v15
					python-jsonschema:single:v15
