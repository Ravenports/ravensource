DEF[PORTVERSION]=	2.16.0.0
# ------------------------------------------------------------------------

NAMEBASE=		python-vcversioner
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Extract version from version control tag (3.14)
SDESC[v15]=		Extract version from version control tag (3.15)
HOMEPAGE=		https://github.com/habnabit/vcversioner
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/v/vcversioner
DISTFILE[1]=		vcversioner-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# ISC

GENERATED=		yes
DISTNAME=		vcversioner-${PORTVERSION}

# install_requires extracted from setup.py


[PY314].USES_ON=			python:v14,sutools
[PY315].USES_ON=			python:v15,sutools

