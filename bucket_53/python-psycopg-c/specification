DEF[PORTVERSION]=	3.3.9
# ------------------------------------------------------------------------

NAMEBASE=		python-psycopg-c
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		C-optimized PostgreSQL database adapter (3.14)
SDESC[v15]=		C-optimized PostgreSQL database adapter (3.15)
HOMEPAGE=		https://psycopg.org/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/psycopg-c
DISTFILE[1]=		psycopg_c-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		psycopg_c-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: tomli >= 2.0.1; python_version < '3.11'

[PY314].USES_ON=			python:v14,pep517
[PY315].USES_ON=			python:v15,pep517

USES=			pgsql:client

pre-configure:
	${REINPLACE_CMD} -e '/setuptools ==/d' ${WRKSRC}/pyproject.toml
