DEF[PORTVERSION]=	0.2.14
# ------------------------------------------------------------------------

NAMEBASE=		python-flask-swagger
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Extract swagger specs from flask project (3.14)
SDESC[v15]=		Extract swagger specs from flask project (3.15)
HOMEPAGE=		https://github.com/gangverk/flask-swagger
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/f/flask-swagger
DISTFILE[1]=		flask-swagger-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		flask-swagger-${PORTVERSION}

# install_requires extracted from setup.py
# Flask>=0.10
# PyYAML>=5.1

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-Flask:single:v14
					python-PyYAML:single:v14
[PY315].USES_ON=			python:v15,sutools
[PY315].BUILDRUN_DEPENDS_ON=		python-Flask:single:v15
					python-PyYAML:single:v15

