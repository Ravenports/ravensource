DEF[PORTVERSION]=	2.5.4
# ------------------------------------------------------------------------

NAMEBASE=		python-numpy
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Array computing for Python (3.14)
SDESC[v15]=		Array computing for Python (3.15)
HOMEPAGE=		https://numpy.org
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/n/numpy
DISTFILE[1]=		numpy-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		numpy-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: meson-python>=0.18.0
# build: Cython>=3.1.0

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-meson-python:single:v14
					python-Cython:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-meson-python:single:v15
					python-Cython:single:v15

LICENSE=		BSD3CLAUSE:single
LICENSE_FILE=		BSD3CLAUSE:{{WRKSRC}}/LICENSE.txt
LICENSE_SCHEME=		solo

BUILD_DEPENDS=		openblas:dev:std
BUILDRUN_DEPENDS=	openblas:primary:std

USES=			cpe pkgconfig c++:single
CPE_VENDOR=		numpy
CPE_PRODUCT=		numpy
