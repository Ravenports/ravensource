# rich>=14.3.3; extra == 'rich'
# covdefaults>=2.3; extra == 'test'
# diff-cover>=9.7.1; extra == 'test'
# nab-index>=0.0.4; extra == 'test'
# nab-python>=0.0.4; extra == 'test'
# pip-requirements-parser>=32; extra == 'test'
# pytest-cov>=7; extra == 'test'
# pytest-mock>=3.15.1; extra == 'test'
# pytest-subprocess>=1.5; extra == 'test'
# pytest>=8.4.2; extra == 'test'
# virtualenv<21,>=20.34; extra == 'test'

[PY313].USES_ON=			python:v13,wheel
[PY313].RUN_DEPENDS_ON=			python-packaging:single:v13
[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-packaging:single:v14

