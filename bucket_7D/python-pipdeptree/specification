DEF[PORTVERSION]=	4.2.0
# ------------------------------------------------------------------------

NAMEBASE=		python-pipdeptree
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v13 v14
SDESC[v13]=		Utility to show package dependency tree (3.13)
SDESC[v14]=		Utility to show package dependency tree (3.14)
HOMEPAGE=		https://github.com/tox-dev/pipdeptree
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/pipdeptree
DISTFILE[1]=		pipdeptree-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v13]=		single
SPKGS[v14]=		single

OPTIONS_AVAILABLE=	PY313 PY314
OPTIONS_STANDARD=	none
VOPTS[v13]=		PY313=ON PY314=OFF
VOPTS[v14]=		PY313=OFF PY314=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		pipdeptree-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: meson-python>=0.20
# build: ninja>=1.13
# buildrun: nab-index>=0.0.11
# buildrun: nab-python>=0.0.11

[PY313].USES_ON=			python:v13,pep517
[PY313].BUILD_DEPENDS_ON=		python-meson-python:single:v13
					python-ninja:single:v13
[PY313].BUILDRUN_DEPENDS_ON=		python-nab-index:single:v13
					python-nab-python:single:v13
[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-meson-python:single:v14
					python-ninja:single:v14
[PY314].BUILDRUN_DEPENDS_ON=		python-nab-index:single:v14
					python-nab-python:single:v14

