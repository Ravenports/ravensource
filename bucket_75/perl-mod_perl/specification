DEF[PORTVERSION]=	2.0.13
# ------------------------------------------------------------------------

NAMEBASE=		perl-mod_perl
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Persistent Perl interpreter for web server (5.42)
SDESC[544]=		Persistent Perl interpreter for web server (5.44)
HOMEPAGE=		none
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:S/SH/SHAY
DISTFILE[1]=		mod_perl-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# Not provided in META.yml

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		mod_perl-${PORTVERSION}

# ---------------------------------------------
# |   Prerequisites extracted from META.yml
# ---------------------------------------------

[PERL_542].USES_ON=			perl:542,configure
[PERL_544].USES_ON=			perl:544,configure

USES=			cpe gmake expat iconv bdb perl:configure
CPE_VENDOR=		apache
CPE_PRODUCT=		mod_perl

BUILD_DEPENDS=		apr1:dev:std
			apr-util:dev:std
			gdbm:dev:std
			apache:dev:std
BUILDRUN_DEPENDS=	apache:primary:std
			gdbm:primary:std

post-patch:
	${FIND} ${WRKSRC} -name "*.orig" -delete
