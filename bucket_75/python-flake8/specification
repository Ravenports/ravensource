					python-pycodestyle:single:v14
					python-pyflakes:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-mccabe:single:v15
					python-pycodestyle:single:v15
					python-pyflakes:single:v15

