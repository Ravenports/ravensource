DEF[PORTVERSION]=	7.5.0
# ------------------------------------------------------------------------

NAMEBASE=		python-flake8
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v13 v14
SDESC[v13]=		Source code checker wrapper (3.13)
SDESC[v14]=		Source code checker wrapper (3.14)
HOMEPAGE=		https://github.com/pycqa/flake8
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/5d/57/a3adc5f380f50ef3d01014cb9d3b8c17b25de9b89def20d559def4fc3c4e
DISTFILE[1]=		flake8-${PORTVERSION}-py2.py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v13]=		single
SPKGS[v14]=		single

OPTIONS_AVAILABLE=	PY313 PY314
OPTIONS_STANDARD=	none
VOPTS[v13]=		PY313=ON PY314=OFF
VOPTS[v14]=		PY313=OFF PY314=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		flake8-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# mccabe<0.8.0,>=0.7.0
# pycodestyle<2.16.0,>=2.15.0
# pyflakes<4.2.0,>=4.1.0

[PY313].USES_ON=			python:v13,wheel
[PY313].RUN_DEPENDS_ON=			python-mccabe:single:v13
					python-pycodestyle:single:v13
					python-pyflakes:single:v13
[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-mccabe:single:v14
					python-pycodestyle:single:v14
					python-pyflakes:single:v14

