DEF[PORTVERSION]=	2.6.15
DEF[LIBOATH]=		0.1.3
DEF[LIBPSKC]=		0.0.1
# ----------------------------------------------------------------------------

NAMEBASE=		oath-toolkit
VERSION=		${PORTVERSION}
KEYWORDS=		security
VARIANTS=		std
SDESC[std]=		Library and tools for OATH authentication
HOMEPAGE=		https://oath-toolkit.codeberg.page/
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		https://codeberg.org/oath-toolkit/oath-toolkit/releases/download/v${PORTVERSION}/
DISTFILE[1]=		oath-toolkit-${PORTVERSION}.tar.gz:main

SPKGS[std]=		set primary tools pam dev man docs

OPTIONS_AVAILABLE=	none
OPTIONS_STANDARD=	none

FPC_EQUIVALENT=		security/oath-toolkit

# file missing: LGPL21+:{{WRKSRC}}/COPYING.LESSERv2
LICENSE=		LGPL21+:primary
			GPLv3+:tools
LICENSE_FILE=		LGPL21+:stock
			GPLv3+:{{WRKSRC}}/COPYING
LICENSE_TERMS=		primary:{{WRKDIR}}/TERMS_LIB
			tools:{{WRKDIR}}/TERMS_TOOLS
LICENSE_SCHEME=		multi


BUILD_DEPENDS=		libxml2:dev:std
			xmlsec:dev:std
			openpam:dev:std
BUILDRUN_DEPENDS=	libxml2:primary:std
			xmlsec:primary:std
			xmlsec:tools:std
			openpam:primary:std

EXRUN[tools]=		primary

USES=			autoreconf gtk-doc libtool mbsdfix pkgconfig perl:build
			gmake
GNOME_COMPONENTS=	libxslt
MUST_CONFIGURE=		gnu
CONFIGURE_ARGS=		--enable-gtk-doc
INSTALL_TARGET=		install-strip
INSTALL_REQ_TOOLCHAIN=	yes

PLIST_SUB=		OATH=${LIBOATH}
			OATH_MAJ=${LIBOATH:R:R}
			PSKC=${LIBPSKC}
			PSKC_MAJ=${LIBPSKC:R:R}

VAR_OPSYS[sunos]=	CFLAGS=-D_POSIX_PTHREAD_SEMANTICS

post-extract:
	${AWK} '/# License/,/# Building/' ${WRKSRC}/README > ${WRKDIR}/TERMS_LIB
	${AWK} '/# License/,/COPYING/' ${WRKSRC}/README > ${WRKDIR}/TERMS_TOOLS

pre-configure:
	# fix shebang
.for f in liboath/man/gdoc libpskc/man/gdoc
	${SED} -i'' '1s|^|#!/${LOCALBASE}/bin/perl\n\n|' ${WRKSRC}/${f}
.endfor
