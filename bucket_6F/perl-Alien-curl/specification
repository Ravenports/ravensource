DEF[PORTVERSION]=	0.11
# ------------------------------------------------------------------------

NAMEBASE=		perl-Alien-curl
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Discovers curl and libcurl (5.42)
SDESC[544]=		Discovers curl and libcurl (5.44)
HOMEPAGE=		https://github.com/PerlAlien/Alien-curl
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:P/PL/PLICEASE
DISTFILE[1]=		Alien-curl-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		Alien-curl-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : Alien::Base
# |        build : Alien::Build
# |        build : Alien::Build::MM
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : Alien::Build
# |    configure : Alien::Build::MM
# |    configure : Env::ShellWords
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : FFI::CheckLib
# |         test : Test2::V0 (perl 5.42 core) (perl 5.44 core)
# |         test : Test::Alien
# |         test : Test::Alien::Diag
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-Alien-Build:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-Env-ShellWords:single:542
					perl-FFI-CheckLib:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-Alien-Build:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-Env-ShellWords:single:544
					perl-FFI-CheckLib:single:544

BUILD_DEPENDS=		curl:dev:std
			perl-PkgConfig:single:perl_default
BUILDRUN_DEPENDS=	curl:primary:std
			curl:tools:std

USES=			pkgconfig ssl:build
