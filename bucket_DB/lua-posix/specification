DEF[PORTVERSION]=	39
DEF[TAG]=		v${PORTVERSION}
# ----------------------------------------------------------------------------

NAMEBASE=		lua-posix
VERSION=		${PORTVERSION}
KEYWORDS=		devel
VARIANTS=		lua52 lua53 lua54 lua55
SDESC[lua52]=		POSIX API bindings for Lua 5.2
SDESC[lua53]=		POSIX API bindings for Lua 5.3
SDESC[lua54]=		POSIX API bindings for Lua 5.4
SDESC[lua55]=		POSIX API bindings for Lua 5.5
HOMEPAGE=		https://github.com/luaposix/luaposix
CONTACT=		Michael_Reim[kraileth@elderlinux.org]

DOWNLOAD_GROUPS=	main
SITES[main]=		GITHUB/luaposix:luaposix:v${PORTVERSION}
DISTFILE[1]=		generated:main

SPKGS[lua52]=		single
SPKGS[lua53]=		single
SPKGS[lua54]=		single
SPKGS[lua55]=		single

OPTIONS_AVAILABLE=	LUA52 LUA53 LUA54 LUA55
OPTIONS_STANDARD=	none
VOPTS[lua52]=		LUA52=ON LUA53=OFF LUA54=OFF LUA55=OFF
VOPTS[lua53]=		LUA52=OFF LUA53=ON LUA54=OFF LUA55=OFF
VOPTS[lua54]=		LUA52=OFF LUA53=OFF LUA54=ON LUA55=OFF
VOPTS[lua55]=		LUA52=OFF LUA53=OFF LUA54=OFF LUA55=ON

LICENSE=		MIT:single
LICENSE_FILE=		MIT:{{WRKSRC}}/LICENSE
LICENSE_SCHEME=		solo

FPC_EQUIVALENT=		devel/lua-posix

# Using %%LUA_MODSHAREDIR%% in manifest does not work for some reason...

VAR_OPSYS[dragonfly]=	CFLAGS=-D__BSD_VISIBLE=1
VAR_OPSYS[midnightbsd]=	CFLAGS=-D__BSD_VISIBLE=1
VAR_OPSYS[sunos]=	CFLAGS=-D_XOPEN_SOURCE=700
			CFLAGS=-D__EXTENSIONS__

[LUA52].DESCRIPTION=			Build with Lua 5.2
[LUA52].USES_ON=			lua:5.2,tools
[LUA52].BUILD_DEPENDS_ON=		lua-luarocks:single:lua52
					lua-luarocks-build-luke:single:lua52
[LUA52].RUN_DEPENDS_ON=			lua-stdlib-normalize:single:lua52

[LUA53].DESCRIPTION=			Build with Lua 5.3
[LUA53].USES_ON=			lua:5.3,tools
[LUA53].BUILD_DEPENDS_ON=		lua-luarocks:single:lua53
					lua-luarocks-build-luke:single:lua53
[LUA53].RUN_DEPENDS_ON=			lua-stdlib-normalize:single:lua53

[LUA54].DESCRIPTION=			Build with Lua 5.4
[LUA54].USES_ON=			lua:5.4,tools
[LUA54].BUILD_DEPENDS_ON=		lua-luarocks:single:lua54
					lua-luarocks-build-luke:single:lua54
[LUA54].RUN_DEPENDS_ON=			lua-stdlib-normalize:single:lua54

[LUA55].DESCRIPTION=			Build with Lua 5.5
[LUA55].USES_ON=			lua:5.5,tools
[LUA55].BUILD_DEPENDS_ON=		lua-luarocks:single:lua55
					lua-luarocks-build-luke:single:lua55
[LUA55].RUN_DEPENDS_ON=			lua-stdlib-normalize:single:lua55

do-build:
	cd ${WRKSRC} && ${SETENV} \
		CC="${CC}" \
		CFLAGS="${CFLAGS}"\
		${LOCALBASE}/bin/luarocks-${LUA_VER} \
		--lua-version=${LUA_VER} make \
		--deps-mode=none \
		--tree=${WRKSRC}/.tree \
		${WRKSRC}/luaposix-${PORTVERSION}-1.rockspec

do-install:
	${MKDIR} ${STAGEDIR}${LUA_MODLIBDIR} ${STAGEDIR}${LUA_MODSHAREDIR}
	cd ${WRKSRC}/.tree/lib/lua/${LUA_VER} && ${COPYTREE_SHARE} posix ${STAGEDIR}${LUA_MODLIBDIR}
	cd ${WRKSRC}/.tree/share/lua/${LUA_VER} && ${COPYTREE_SHARE} posix ${STAGEDIR}${LUA_MODSHAREDIR}
	${FIND} ${STAGEDIR}${LUA_MODLIBDIR}/posix -name '*.so' -exec ${STRIP_CMD} {} +
