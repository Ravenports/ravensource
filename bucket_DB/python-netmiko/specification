NAMEBASE=		python-netmiko
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Simplify CLI connections to network devices (3.14)
SDESC[v15]=		Simplify CLI connections to network devices (3.15)
HOMEPAGE=		https://pypi.org/project/netmiko/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/0c/0d/796ef54d10e5af8a9af12a431ad278d74d9139c4888599c2073b2eec814d
DISTFILE[1]=		netmiko-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# MIT

GENERATED=		yes
DISTNAME=		netmiko-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# ntc-templates>=3.1.0
# paramiko>=3.5.1
# pyserial>=3.3
# pyyaml>=6.0.2
# rich>=13.8
# scp>=0.13.6
# textfsm>=1.1.3
# ruamel-yaml>=0.17; extra == 'bulk-encrypt'
# paramiko<5.0,>=4.0; extra == 'par4'

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-ntc-templates:single:v14
					python-paramiko:single:v14
					python-pyserial:single:v14
					python-PyYAML:single:v14
					python-rich:single:v14
					python-scp:single:v14
					python-textfsm:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-ntc-templates:single:v15
					python-paramiko:single:v15
					python-pyserial:single:v15
					python-PyYAML:single:v15
					python-rich:single:v15
					python-scp:single:v15
					python-textfsm:single:v15

USES=			shebangfix
SHEBANG_FILES=		stage{{PYTHON_SITELIBDIR}}/netmiko/cli_tools/netmiko_*.py
