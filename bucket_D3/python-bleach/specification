DEF[PORTVERSION]=	6.4.0
# ------------------------------------------------------------------------

NAMEBASE=		python-bleach
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Easy safelist-based HTML-sanitizing tool (3.14)
SDESC[v15]=		Easy safelist-based HTML-sanitizing tool (3.15)
HOMEPAGE=		https://github.com/mozilla/bleach
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/58/9d/40b6267367182187139a4000b82a3b287d84d745bccd808e75d916920e9d
DISTFILE[1]=		bleach-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Apache Software License

GENERATED=		yes
DISTNAME=		bleach-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# webencodings
# tinycss2>=1.1.0; extra == "css"

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-webencodings:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-webencodings:single:v15

USES=			cpe shebangfix
CPE_VENDOR=		mozilla
CPE_PRODUCT=		bleach
SHEBANG_FILES=		stage{{PYTHON_SITELIBDIR}}/bleach/_vendor/vendor_install.sh
