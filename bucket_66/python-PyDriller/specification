DEF[PORTVERSION]=	2.12
# ------------------------------------------------------------------------

NAMEBASE=		python-PyDriller
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Framework for MSR (3.14)
SDESC[v15]=		Framework for MSR (3.15)
HOMEPAGE=		https://github.com/ishepard/pydriller
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/84/39/467c0a5f0edfba63435ff6777fae993782d1ec561508a3dbc46ceff73331
DISTFILE[1]=		pydriller-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Apache License

GENERATED=		yes
DISTNAME=		pydriller-${PORTVERSION}.dist-info

# Requires-Dist extracted from wheel metadata
# gitpython
# pytz
# types-pytz
# lizard

[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-GitPython:single:v14
					python-pytz:single:v14
					python-types-pytz:single:v14
					python-lizard:single:v14
[PY315].USES_ON=			python:v15,wheel
[PY315].RUN_DEPENDS_ON=			python-GitPython:single:v15
					python-pytz:single:v15
					python-types-pytz:single:v15
					python-lizard:single:v15

pre-install:
	${RM} ${STAGEDIR}${PREFIX}/*requirements.txt
