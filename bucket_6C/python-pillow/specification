DEF[PORTVERSION]=	13.0.0
# ------------------------------------------------------------------------

NAMEBASE=		python-pillow
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Python Imaging Library (fork) (3.14)
SDESC[v15]=		Python Imaging Library (fork) (3.15)
HOMEPAGE=		https://python-pillow.org
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/p/pillow
DISTFILE[1]=		pillow-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		pillow-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: pybind11

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-pybind11:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-pybind11:single:v15

USES=			cpe jpeg zlib
CPE_VENDOR=		python
CPE_PRODUCT=		pillow
