DEF[PORTVERSION]=	1.4.5
# ------------------------------------------------------------------------

NAMEBASE=		python-borgbackup
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Deduplicated, encrypted, compressed backups (3.14)
SDESC[v15]=		Deduplicated, encrypted, compressed backups (3.15)
HOMEPAGE=		https://borgbackup.org/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/b/borgbackup
DISTFILE[1]=		borgbackup-${PORTVERSION}.tar.gz:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

# License listed at PyPI
# Not provided.

GENERATED=		yes
DISTNAME=		borgbackup-${PORTVERSION}

# Requires-Dist extracted from pyproject.toml file
# build: setuptools_scm>=8
# build: pkgconfig
# build: Cython>=3.0.3
# buildrun: msgpack >=1.0.3, <=1.2.1
# buildrun: packaging

[PY314].USES_ON=			python:v14,pep517
[PY314].BUILD_DEPENDS_ON=		python-setuptools-scm:single:v14
					python-pkgconfig:single:v14
					python-Cython:single:v14
[PY314].BUILDRUN_DEPENDS_ON=		python-msgpack:single:v14
					python-packaging:single:v14
[PY315].USES_ON=			python:v15,pep517
[PY315].BUILD_DEPENDS_ON=		python-setuptools-scm:single:v15
					python-pkgconfig:single:v15
					python-Cython:single:v15
[PY315].BUILDRUN_DEPENDS_ON=		python-msgpack:single:v15
					python-packaging:single:v15

BUILD_DEPENDS=		xxhash:dev:std
BUILDRUN_DEPENDS=	xxhash:primary:std

USES=			cpe ssl lz4 zstd
CPE_VENDOR=		borgbackup
CPE_PRODUCT=		borg
MAKE_ENV=		BORG_OPENSSL_PREFIX={{OPENSSLBASE}}

VAR_OPSYS[freebsd]=	CFLAGS=-Wno-implicit-function-declaration

post-patch:
	${SED} -i'' -e 's|msgpack-python|msgpack|' \
	${WRKSRC}/setup.py ${WRKSRC}/src/borgbackup.egg-info/requires.txt

post-extract-freebsd:
	${CP} ${FILESDIR}/acl_extended_file_np.c ${WRKSRC}/src/borg/platform/
