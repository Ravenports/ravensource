NAMEBASE=		python-social-auth-core2
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Social authentication/registration (3.14)
SDESC[v15]=		Social authentication/registration (3.15)
HOMEPAGE=		https://github.com/dongkai1993/social-core
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPI/s/social-auth-core2
