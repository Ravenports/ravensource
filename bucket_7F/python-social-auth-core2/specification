# install_requires extracted from setup.py
# requests>=2.9.1
# oauthlib>=1.0.3
# requests-oauthlib>=0.6.1
# six>=1.10.0
# PyJWT>=1.4.0

[PY314].USES_ON=			python:v14,sutools
[PY314].BUILDRUN_DEPENDS_ON=		python-requests:single:v14
					python-oauthlib:single:v14
					python-requests-oauthlib:single:v14
					python-six:single:v14
					python-PyJWT:single:v14
[PY315].USES_ON=			python:v15,sutools
[PY315].BUILDRUN_DEPENDS_ON=		python-requests:single:v15
					python-oauthlib:single:v15
					python-requests-oauthlib:single:v15
