DEF[PORTVERSION]=	2.59
# ------------------------------------------------------------------------

NAMEBASE=		perl-XML-Parser
VERSION=		${PORTVERSION}
KEYWORDS=		perl
VARIANTS=		542 544
SDESC[542]=		Perl module for parsing XML documents (5.42)
SDESC[544]=		Perl module for parsing XML documents (5.44)
HOMEPAGE=		https://github.com/cpan-authors/XML-Parser
CONTACT=		Perl_Automaton[perl@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		CPAN/ID:T/TO/TODDR
DISTFILE[1]=		XML-Parser-${PORTVERSION}.tar.gz:main

SPKGS[542]=		single
SPKGS[544]=		single

OPTIONS_AVAILABLE=	PERL_542 PERL_544
OPTIONS_STANDARD=	none
VOPTS[542]=		PERL_542=ON PERL_544=OFF
VOPTS[544]=		PERL_542=OFF PERL_544=ON

# License listed in CPAN directory:
# perl_5

GENERATED=		yes
SINGLE_JOB=		yes
DISTNAME=		XML-Parser-${PORTVERSION}

# ----------------------------------------------
# |   Prerequisites extracted from META.json
# ----------------------------------------------
# |      runtime : File::ShareDir
# |      runtime : LWP::UserAgent
# |        build : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : ExtUtils::MakeMaker (perl 5.42 core) (perl 5.44 core)
# |    configure : File::ShareDir::Install
# |         test : Test::More (perl 5.42 core) (perl 5.44 core)
# |         test : warnings (perl 5.42 core) (perl 5.44 core)

[PERL_542].USES_ON=			perl:542,configure
[PERL_542].BUILDRUN_DEPENDS_ON=		perl-File-ShareDir:single:542
					perl-libwww-perl:single:542
[PERL_542].BUILD_DEPENDS_ON=		perl-File-ShareDir-Install:single:542
[PERL_544].USES_ON=			perl:544,configure
[PERL_544].BUILDRUN_DEPENDS_ON=		perl-File-ShareDir:single:544
					perl-libwww-perl:single:544
[PERL_544].BUILD_DEPENDS_ON=		perl-File-ShareDir-Install:single:544

USES=			expat
CONFIGURE_ARGS=		EXPATLIBPATH={{LOCALBASE}}/lib
			EXPATINCPATH={{LOCALBASE}}/include

VAR_OPSYS[linux]=	CFLAGS=-Doff64_t=__off64_t

post-patch:
	${REINPLACE_CMD} "s|@PERL_RPATH@|${PREFIX}/lib/perl5/${PERL_VER}/${PERL_ARCH}/CORE|" \
		${WRKSRC}/Expat/Makefile.PL
