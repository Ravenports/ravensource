DEF[PORTVERSION]=	5.1.0
# ------------------------------------------------------------------------

NAMEBASE=		python-reportlab
VERSION=		${PORTVERSION}
KEYWORDS=		python
VARIANTS=		v14 v15
SDESC[v14]=		Library for generating PDFs and graphics (3.14)
SDESC[v15]=		Library for generating PDFs and graphics (3.15)
HOMEPAGE=		https://www.reportlab.com/
CONTACT=		Python_Automaton[python@ravenports.com]

DOWNLOAD_GROUPS=	main
SITES[main]=		PYPIWHL/4a/3c/bf68d44f160b44685fc714f746a954c71d0091b3dc4fd3c8670154b44841
DISTFILE[1]=		reportlab-${PORTVERSION}-py3-none-any.whl:main
DIST_SUBDIR=		python-src

SPKGS[v14]=		single
SPKGS[v15]=		single

OPTIONS_AVAILABLE=	PY314 PY315
OPTIONS_STANDARD=	none
VOPTS[v14]=		PY314=ON PY315=OFF
VOPTS[v15]=		PY314=OFF PY315=ON

