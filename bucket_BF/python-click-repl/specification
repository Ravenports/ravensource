# typing-extensions>=4.7.0
# pytest>=7.2.1; extra == "testing"
# pytest-cov>=4.0.0; extra == "testing"
# tox>=4.4.3; extra == "testing"
# flake8>=6.0.0; extra == "testing"
# mypy>=1.9.0; extra == "testing"

[PY313].USES_ON=			python:v13,wheel
[PY313].RUN_DEPENDS_ON=			python-click:single:v13
					python-prompt-toolkit:single:v13
					python-typing-extensions:single:v13
[PY314].USES_ON=			python:v14,wheel
[PY314].RUN_DEPENDS_ON=			python-click:single:v14
					python-prompt-toolkit:single:v14
					python-typing-extensions:single:v14

